scussions":[{"author":{"id":1521002,"avatar":"https://static001.geekbang.org/account/avatar/00/17/35/6a/7997de5a.jpg","nickname":"晓寒","note":"","ucode":"8BB0F59591B8CC","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":681571,"discussion_content":"说实话我个人不建议企业里直接用Openclaw，到目前为止安全漏洞和成本问题还没解决，只适合小规模在没有敏感信息的场景尝试。如果非要用的话，首先是云端部署，限制好访问权限以及skill安装的范围防止恶意skill，做好日志和审计，做好token成本限制，再去考虑能力吧。其实企业场景的需求相对固定，不像个人这样五花八门，还是自己搭专门的应用更靠谱。","content_length":476,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1772163607,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"北京","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":406218,"user_name":"苏彧","can_delete":false,"product_type":"c3","uid":1622448,"ip_address":"浙江","ucode":"C016B28DF7449C","user_header":"https://static001.geekbang.org/account/avatar/00/18/c1/b0/b52d9ade.jpg","comment_is_top":false,"comment_ctime":1774371952,"is_pvip":false,"replies":[{"id":151002,"content":"是agent自己判断触发的，实际上会触发启用memory search的情况非常少，大多数是用户显示的提及有明确回忆之前的需求，才会触发","user_name":"作者回复","user_name_real":"编辑","uid":1521002,"ctime":1774504513,"ip_address":"北京","comment_id":406218,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":101114301,"comment_content":"老师 有个问题请教下，在长记忆搜索那一块的第二层系统内置的memory search工具是在什么情况下触发的呢， 是每次用户问的时候都会去搜索一遍吗","like_count":0,"discussions":[{"author":{"id":1521002,"avatar":"https://static001.geekbang.org/account/avatar/00/17/35/6a/7997de5a.jpg","nickname":"晓寒","note":"","ucode":"8BB0F59591B8CC","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":682750,"discussion_content":"是agent自己判断触发