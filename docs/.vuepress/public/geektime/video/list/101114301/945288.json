delete":false,"product_type":"c3","uid":4475468,"ip_address":"浙江","ucode":"D9D02AC51CC981","user_header":"","comment_is_top":false,"comment_ctime":1772897378,"is_pvip":false,"replies":[{"id":150756,"content":"两个不冲突，skills是教模型怎么做事情，以及封装工具的，是一个单智能体自己用skills，还是单智能体委托sub agent用skills，都是可以的。后面教到skills的时候会聊","user_name":"作者回复","user_name_real":"编辑","uid":1521002,"ctime":1773123456,"ip_address":"北京","comment_id":405787,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":101114301,"comment_content":"老师，想请教一下，在 toB 的企业级场景里多智能体模式和 skills 模式该怎么选型？最近 skills 模式风头正劲，公司产品经理和客户都想要 skills 模式的，企业级场景效果很重要，甚至直接关系到项目能否竣工， skills 模式相比多智能体是否确实有优势？","like_count":1,"discussions":[{"author":{"id":1521002,"avatar":"https://static001.geekbang.org/account/avatar/00/17/35/6a/7997de5a.jpg","nickname":"晓寒","note":"","ucode":"8BB0F59591B8CC","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":682142,"discussion_content":"两个不冲突，skills是教模型怎么做事情，以及封装工具的，是一个单智能体自己用skills，还是单智能体委托sub agent用skills，都是可以的。后面教到skills的时候会聊","content_length":213,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1773123457,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"北京","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":405766,"user_name":"Rye","can_delete":false,"product_type":"c3","uid":1175100,"ip_address":"北京","ucode":"5BDC40ED641A6C","user_header":"https://static001.geekbang.org/account/avatar/00/11/ee/3c/a2b67971.jpg","comment_is_top":false,"comment_ctime":1772777749,"is_pvip":false,"replies":[{"id":150689,"content":"组织和分工是非常重要的，所谓的互相安排实践起来会变成一锅粥。multi-agent中，什么情况用什么组织方式是最核心的设计，如果都在群里看openclaw自己组织，就像在公司里不做分工一群人做项目一样","user_name":"作者回复","user_name_real":"编辑","uid":1521002,"ctime":1772792687,"ip_address":"北京","comment_id":405766,"utype":1}],"discussion_count":0,"race_medal":0,"score":2,"product_id":101114301,"comment_content":"muti-agent 的设计思路是每个Agent有不同的角色，每个Agent可以给其他Agent安排任务，这个模式，和启动很多个openClaw 把所有openClaw 拉到一个群里让openClaw可以互相安排任务，这两种方式哪种更合理呢","like_count":1},{"had_liked":false,"id":405660,"user_name":"zcy","can_delete":false,"product_type":"c3","uid":1014797,"ip_address":"安徽","ucode":"368EC653624579","user_header":"https://static001.geekbang.org/account/avatar/00/0f/7c/0d/abb7bfe3.jpg","comment_is_top":false,"comment_ctime":1772513159,"is_pvip":false,"replies":[{"id":150629,"content":"代码点开本节摘要，里面有代码库地址可以看下","user_name":"作者回复","user_name_real":"编辑","uid":1521002,"ctime":1772535865,"ip_address":"北京","comment_id":405660,"utype":1}],"discussion_count":2,"race_medal":0,"score":2,"product_id":101114301,"comment_content":"请问一下这个代码是放在哪里？是单独的一个程序吗？agent之间通信是通过什么实现的？","like_count":1,"discussions":[{"author":{"id":1521002,"avatar":"https://static001.geekbang.org/account/avatar/00/17/35/6a/7997de5a.jpg","nickname":"晓寒","note":"","ucode":"8BB0F59591B8CC","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":681775,"discussion_content":"代码点开本节摘要，里面有代码库地址可以看下","content_length":63,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1772535865,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"北京","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1667175,"avatar":"https://static001.geekbang.org/account/avatar/00/19/70/67/0c1359c2.jpg","nickname":"qinsi","note":"","ucode":"090D9C4068FF12","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":681819,"