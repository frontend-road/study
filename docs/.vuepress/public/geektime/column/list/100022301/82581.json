"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":439905,"discussion_content":"多练习","content_length":3,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1550654965,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":2148913,"avatar":"","nickname":"Geek6241","note":"","ucode":"B0ABD28A20AF9C","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":331082,"discussion_content":"个人认为变量名没必要非得用英文，只要含义明确、清晰、无混淆就行了。\n我很反感一个观点：用英文更专业。","content_length":50,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1606784453,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":1,"child_discussions":[{"author":{"id":3803225,"avatar":"https://static001.geekbang.org/account/avatar/00/3a/08/59/92b03764.jpg","nickname":"yini","note":"","ucode":"575F473C7549F7","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":2148913,"avatar":"","nickname":"Geek6241","note":"","ucode":"B0ABD28A20AF9C","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":637015,"discussion_content":"用中文拼音还涉及到音调问题，很难一眼看过去知道表达什么意思吧","content_length":30,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1707642199,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":331082,"ip_address":"浙江","group_id":0,"attachments":[]},"score":637015,"extra":""}]}]},{"had_liked":false,"id":69619,"user_name":"梦倚栏杆","can_delete":false,"product_type":"c1","uid":1095857,"ip_address":"","ucode":"BDEB97F2822445","user_header":"http://thirdwx.qlogo.cn/mmopen/vi_32/bvj76PmeUvW8kokyu91IZWuRATKmabibDWbzAj2TajeEic7WvKCJOLaOh6jibEmdQ36EO3sBUZ0HibAiapsrZo64U8w/132","comment_is_top":false,"comment_ctime":1550798200,"is_pvip":false,"replies":[{"id":24883,"content":"起名字难，难在起一个具体的名字，很多人太容易随手起一个通用的名字。","user_name":"作者回复","user_name_real":"dreamhead","uid":1258861,"ctime":1550896538,"ip_address":"","comment_id":69619,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100022301,"comment_content":"order 这个例子举得特别形象，深有体会。我们这边就是写代码的时候一个地方把task名字占用了，然后其他地方的task懵逼了","like_count":11,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":440190,"discussion_content":"起名字难，难在起一个具体的名字，很多人太容易随手起一个通用的名字。","content_length":33,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1550896538,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":69445,"user_name":"TH","can_delete":false,"product_type":"c1","uid":1053413,"ip_address":"","ucode":"C5EA20546DC09C","user_header":"https://static001.geekbang.org/account/avatar/00/10/12/e5/592d9324.jpg","comment_is_top":false,"comment_ctime":1550747772,"is_pvip":true,"replies":[{"id":24669,"content":"分清可变和不变，这是很赞的做法！","user_name":"作者回复","user_name_real":"dreamhead","uid":1258861,"ctime":1550749783,"ip_address":"","comment_id":69445,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100022301,"comment_content":"领域驱动设计确实是写出合适的代码结构的一项训练，程序员会不由自主地按照自己的习惯，也就是按照计算机运行逻辑去设计代码，这样的代码很容易陷入难以维护的坑。在开始动手写代码之前跟用户交流清楚，理解设计的概念、流程、使用场景、特殊情况，这些都很重要。另外我特别关注的一点是可变项和不变项的分离，因为我们的业务场景对可扩展性要求很高","like_count":9,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":440126,"discussion_content":"分清可变和不变，这是很赞的做法！","content_length":16,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1550749783,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":68979,"user_name":"行与修","can_delete":false,"product_type":"c1","uid":1241842,"ip_address":"","ucode":"11F21B663EF6D3","user_header":"https://static001.geekbang.org/account/avatar/00/12/f2/f2/2a9a6e9a.jpg","comment_is_top":false,"comment_ctime":1550637658,"is_pvip":false,"replies":[{"id":24598,"content":"有益的思考","user_name":"作者回复","user_name_real":"dreamhead","uid":1258861,"ctime":1550713221,"ip_address":"","comment_id":68979,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100022301,"comment_content":"在了解业务的基础上，我觉得写好代码之前要做两个铺垫：设计和分解。设计可以是整体的，也可以是局部的，厘清思路为适度。分解即任务分解，保证代码铺开有章可循。新人入行，有了一闪而过的灵感往往就动手了，随着深入再往返折回很是忙碌，经验不足是客观存在的，但习惯还是早培养早受益，经验不足者那就做些简单的设计，等丰富了再做细致的设计就好，个人倾向于前面多花点时间。写代码要通俗易懂，条理清晰，阶段性项目内部review，让不同模块编写者来执行。另外我是不建议用中文命名的，此时用中文注释补充也未尝不可。","like_count":9,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":439899,"discussion_content":"有益的思考","content_length":5,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1550713221,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":75683,"user_name":"马斯费油","can_delete":false,"product_type":"c1","uid":1198556,"ip_address":"","ucode":"8BB82459191E49","user_header":"https://static001.geekbang.org/account/avatar/00/12/49/dc/1650abcb.jpg","comment_is_top":false,"comment_ctime":1552449023,"is_pvip":false,"replies":[{"id":27607,"content":"这个说法很到位！","user_name":"作者回复","user_name_real":"dreamhead","uid":1258861,"ctime":1552454963,"ip_address":"","comment_id":75683,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100022301,"comment_content":"代码主要是为了写给人看的，而不是写给机器看的，只是顺便也能用机器执行而已","like_count":6,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":442983,"discussion_content":"这个说法很到位！","content_length":8,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1552454963,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":69371,"user_name":"布衣骇客","can_delete":false,"product_type":"c1","uid":1256280,"ip_address":"","ucode":"5226B0F67090D1","user_header":"https://static001.geekbang.org/account/avatar/00/13/2b/58/11c05ccb.jpg","comment_is_top":false,"comment_ctime":1550730181,"is_pvip":false,"replies":[{"id":24701,"content":"继续加油！","user_