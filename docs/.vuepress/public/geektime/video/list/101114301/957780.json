type":"c3","uid":1392739,"ip_address":"浙江","ucode":"1869935E01F96F","user_header":"https://static001.geekbang.org/account/avatar/00/15/40/63/af707efa.jpg","comment_is_top":false,"comment_ctime":1775785807,"is_pvip":false,"replies":[{"id":151226,"content":"其实两者实现完全不一样，建议再好好看一下视频，MCP是远端的服务器，然后提供了一套标准的协议，让Agent通过远端的请求去完成工具的使用。而Skill的话，本质上是一个说明文档，让Agent使用Bash的命令去读文件，然后自己写代码去使用工具。","user_name":"作者回复","user_name_real":"编辑","uid":1521002,"ctime":1775816437,"ip_address":"北京","comment_id":406729,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":101114301,"comment_content":"Mcp和skill的区别一直没弄很清楚，不过感觉mcp重点解决的是怎么连接的问题，skill重点解决工具怎么用的问题，而skill和mcp都能做工具，比如mcp的tool list可以调用接口获取数据，skill下的脚本也可以做；那什么时候用mcp什么时候用skill呢？","like_count":0,"discussions":[{"author":{"id":1521002,"avatar":"https://static001.geekbang.org/account/avatar/00/17/35/6a/7997de5a.jpg","nickname":"晓寒","note":"","ucode":"8BB0F59591B8CC","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":683690,"discussion_content":"其实两者实现完全不一样，建议再好好看一下视频，MCP是远端的服务器，然后提供了一套标准的协议，让Agent通过远端的请求去完成工具的使用。而Skill的话，本质上是一个说明文档，让Agent使用Bash的命令去读文件，然后自己写代码去使用工具。","content_length":322,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1775816437,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"北京","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":406614,"user_name":"Bravemen","can_delete":false,"product_type":"c3","uid":2809585,"ip_address":"广东","ucode":"4C1CB88867FC6B","user_header":"https://static001.geekbang.org/account/avatar/00/2a/de/f1/843f45db.jpg","comment_is_top":false,"comment_ctime":1775460074,"is_pvip":false,"replies":[{"id":151191,"content":"如果考虑安全的话，这个是企业级通常的解决方案","user_name":"作者回复","user_name_real":"编辑",