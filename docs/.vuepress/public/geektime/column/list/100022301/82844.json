ABA5CA98C4","user_header":"https://static001.geekbang.org/account/avatar/00/11/7c/06/cbc08b32.jpg","comment_is_top":false,"comment_ctime":1555763130,"is_pvip":false,"replies":[{"id":32108,"content":"如果他们就是不专业，怎么办呢？","user_name":"作者回复","user_name_real":"dreamhead","uid":1258861,"ctime":1556236643,"ip_address":"","comment_id":87945,"utype":1}],"discussion_count":3,"race_medal":0,"score":2,"product_id":100022301,"comment_content":"很多会往往是因为谁也不想拍板做决策，没人愿意主动与各方沟通决策，只好开会一起沟通，实际开会的效率也很低。这主要是团队leader或项目owner不够尽职。","like_count":7,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":447660,"discussion_content":"如果他们就是不专业，怎么办呢？","content_length":15,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1556236643,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1496539,"avatar":"https://static001.geekbang.org/account/avatar/00/16/d5/db/3f9499d1.jpg","nickname":"勇闯天涯","note":"","ucode":"3C0F9F7DA2CA9A","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":327006,"discussion_content":"如果owner或者leader不专业，那就按照专业的角度思考问题，给出专业意见，如果leader或owner不同意，又给不出好的说法，那就换一个环境，或者找机会将不专业的leader干掉，自己上位","content_length":98,"likes_number":3,"is_delete":false,"is_hidden":false,"ctime":1605713713,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"chil