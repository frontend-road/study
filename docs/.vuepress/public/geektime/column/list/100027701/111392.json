":"3556786538664F","user_header":"https://static001.geekbang.org/account/avatar/00/12/79/4b/740f91ca.jpg","comment_is_top":false,"comment_ctime":1564447942,"is_pvip":false,"replies":[{"id":43636,"content":"g1实现很复杂，有人专门写了本书来讲，原理入门可以看看这篇文章：https:&#47;&#47;yq.aliyun.com&#47;articles&#47;444436","user_name":"作者回复","user_name_real":"Haoshuang","uid":1266132,"ctime":1564491096,"ip_address":"","comment_id":118792,"utype":1}],"discussion_count":5,"race_medal":0,"score":2,"product_id":100027701,"comment_content":"李老师好!感觉老师今天偷懒了，CMS负责老年代回收，年轻代一般配合parNew使用。\n大概啥情况下使用G1比较好啊?之前看见网上说，大堆多核，jdk9以及以上可以使用G1，jdk8的话除非cms满足不了需求不然不建议使用G1。\nG1不太了解老师能推荐下资料么?\n我觉得工具，可以提高效率，初学者优先搞清楚原理扎实基础比较好。","like_count":14,"discussions":[{"author":{"id":1266132,"avatar":"http://thirdwx.qlogo.cn/mmopen/vi_32/Q0j4TwGTfTIqtPHYrZKKTPAC2uSGwxZOwrN3qxcrcvMxEBzzE0QZf2vHfm17PuNvn5gLIOoPEFc7bOoOVxQQTw/132","nickname":"Haoshuang","note":"","ucode":"78B2EE7E09A029","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":460580,"discussion_content":"g1实现很复杂，有人专门写了本书来讲，原理入门可以看看这篇文章：https://yq.aliyun.com/articles/444436","content_length":69,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1564491096,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1014401,"avatar":"https://static001.geekbang.org/account/avatar/00/0f/7a/81/69874318.jpg","nickname":"ding","note":"","ucode":"54AF950B3CA740","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":588339,"discussion_content":"地址打不开了","content_length":6,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":16636