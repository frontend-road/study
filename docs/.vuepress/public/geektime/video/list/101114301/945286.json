":[]}]},{"had_liked":false,"id":405492,"user_name":"川杰","can_delete":false,"product_type":"c3","uid":1099750,"ip_address":"浙江","ucode":"815211E1D698E6","user_header":"https://static001.geekbang.org/account/avatar/00/10/c7/e6/11f21cb4.jpg","comment_is_top":false,"comment_ctime":1772017901,"is_pvip":false,"replies":null,"discussion_count":9,"race_medal":0,"score":3,"product_id":101114301,"comment_content":"请问个问题，对于signle agent自主决策，这点我有疑问：在一些专业的业务领域，如金融，在我们已经有了相对应的工具的情况下，agent是如何“自主”的分析出解决问题的路径的？我的意思是，无论agent有多么智能，它还是需要依赖人类去告诉它，这个专业问题的解决步骤是1,2,3，虽然我们可以通过“微调”等手段让【通用大模型】变成【专业金融领域大模型】，但我觉得，agent还是无法离开人类告诉他解决步骤1-&gt;步骤2-&gt;步骤3；所以我不理解，这个自主决策到底能做到什么地步？","like_count":3,"discussions":[{"author":{"id":1099750,"avatar":"https://static001.geekbang.org/account/avatar/00/10/c7/e6/11f21cb4.jpg","nickname":"川杰","note":"","ucode":"815211E1D698E6","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":681521,"discussion_content":"所以我的困惑就在于老师视频里说的“自主”，我认为说白了，现在的AI都是“伪自主”，哪怕是大模型本身表现出的“智能”，也是在数以万计的“输入”后得到的一个最相近的结论而已。举个例子，如果我发一段话：帮我订个周杰伦的演唱会门票。大模型大概率可以“自主”分析出，先询问什么场次，再调用查询接口，再调用订票接接口。但这也是基于成千上万个类似案例得到的决策结果。","content_length":524,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1772083229,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"浙江","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":6,"child_discussions":[{"author":{"id":1521002,"avatar":"https://static001.geekbang.org/account/avatar/00/17/35/6a/7997de5a.jpg","nickname":"晓寒","note":"","ucode":"8BB0F59591B8CC","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":1099750,"avatar":"https://static001.geekbang.org/account/avatar/00/10/c7/e6/11f21cb4.jpg","nickname":"川杰","note":"","ucode":"815211E1D698E6","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":681532,"discussion_content":"其实现在很多的案例里面，这个自主性已经很超出预期了。比如最近的小龙虾，有个case是用户给它发了一段语音，它之前本身没有语音解析的功能，但是它有浏览器和搜索，于是它自己搜索怎么解析语音，然后自己写代码调用了网上的asr接口，最后自己解析了语音的内容。其实现在完全私有化知识已经很少了，一方面被训练到模型里的知识很多，另一方面借助工具总有办法获取，但是前提是你要给你的agent足够的工具和权限。","content_length":567,"likes_number":1,"is_delete":false,"is_hidden":false,"ctime":1772113683,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":681521,"ip_address":"北京","group_id":0,"attachments":[]},"score":681532,"extra":""},{"author":{"id":1099750,"avatar":"https://static001.geekbang.org/account/avatar/00/10/c7/e6/11f21cb4.jpg","nickname":"川杰","note":"","ucode":"815211E1D698E6","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":1521002,"avatar":"https://static001.geekbang.org/account/avatar/00/17/35/6a/7997de5a.jpg","nickname":"晓寒","note":"","ucode":"8BB0F59591B8CC","race_medal":0,"user_type":2,"is_pvip":false},"discussion":{"id":681537,"discussion_content":"嗯，所以这个自主性来源于：当“我”不知道怎么处理时，我去搜索引擎搜索解决方案。并且这个解决方案没有网络权限等问题，那么大模型就可以基于这个方案去尝试。\n这其实也是人类的工作方式，被提前输入到大模型里了。\n懂了，谢谢。","content_length":320,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1772114377,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":681532,"ip_address":"浙江","group_id":0,"attachments":[]},"score":681537,"extra":""},{"author":{"id":2809585,"avatar":"https://static001.geekbang.org/account/avatar/00/2a/de/f1/843f45db.jpg","nickname":"Bravemen","note":"","ucode":"4C1CB88867FC6B","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":1099750,"avatar":"https://static001.geekbang.org/account/avatar/00/10/c7/e6/11f21cb4.jpg","nickname":"川杰","note":"","ucode":"815211E1D698E6","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":681578,"discussion_content":"引用X上大V说法，如果选择Agent范式，就要把更多的选择权交给Agent，让他自主来解决，可能结果会让你惊讶，但也可能寸步难行。随着LLM的演进，自主性是未来释放生产力的本质，否则就做成SaaS了","content_length":259,"likes_number":2,"is_delete":false,"is_hidden":false,"ctime":1772175905,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":681537,"ip_address":"安徽","group_id":0,"attachments":[]},"score":681578,"extra":""}]},{"author":{"id":1164003,"avatar":"https://static001.geekbang.org/account/avatar/00/11/c2/e3/df7447ff.jpg","nickname":"008","note":"","ucode":"E1D9D91E18208A","race_medal":1,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":681505,"discussion_content":"垂直领域的专业知识都是需要模型“学习”的，模型训练过程就是人类告诉它解决步骤的过程。\n所有的自主决策都是基于它“学习”到的能力开展的，本质上脱离不了人类的“教育”。","content_length":244,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1772033283,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"广东","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":1,"child_discussions":[{"author":{"id":2809585,"avatar":"https://static001.geekbang.org/account/avatar/00/2a/de/f1/843f45db.jpg","nickname":"Bravemen","note":"","ucode":"4C1CB88867FC6B","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":1164003,"avatar":"https://static001.geekbang.org/account/avatar/00/11/c2/e3/df7447ff.jpg","nickname":"008","note":"","ucode":"E1D9D91E18208A","race_medal":1,"user_type":1,"is_pvip":false},"discussion":{"id":681579,"discussion_content":"量变产生质变，人类有其与生俱来的局限性，不一定是AI被教育，在全球智慧的涌现下，最终绝大部分时候都是AI教育人类，少数奇点，人的经验会被AI学习","content_length":204,"likes_number":1,"is_delete":false,"is_hidden":false,"ctime":1772176145,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":681505,"ip_address":"安徽","group_id":0,"attachments":[]},"score":681579,"extra":""}]}]},{"had_liked":false,"id":405527,"user_name":"kxydoublek","can_delete":false,"product_type":"c3","uid":1214264,"ip_address":"安徽","ucode":"9FA6D0AE763AE9","user_header":"https://static001.geekbang.org/account/avatar/00/12/87/38/680b20bb.jpg","comment_is_top":false,"comment_ctime":1772105504,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":101114301,"comment_content":"正在做一个打印语音助手，输入就是完全不确定的，用户可能查询打印机状态信息，可能设置打印机，可能下发打印命令，或者和打印机闲聊。所以目前采用的是单智能体+调用MCP工具的方式。感谢老师解答了多智能体解决的问题和为什么会出现多智能体的原因。期待后面课程的更新。","like_count":2},{"had_liked":false,"id":405838,"user_name":"李某某","can_delete":false,"product_type":"c3","uid":1392739,"ip_address":"浙江","ucode":"1869935E01F96F","user_header":"https://static001.geekbang.org/account/avatar/00/15/40/63/af707efa.jpg","comment_is_top":false,"comment_ctime":1773064122,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":101114301,"comment_content":"目前在实践的有两个场景：\n1. 内部系统的客服机器人，对于用户问题是完全不确定的，之前使用过dify的问答机器人和工作流，发现问答机器人结合知识库效果比工作流要好，现在看可能要用agent，不过还没太明白agent如何落地以及和其他两种的核心区别\n2. 群内信息收集机器人，业务和结果都比较确定，结构用户信息并调用接口保存，使用的是prompt，但是效果也不太行，因为用户回答是不决定的，肯定必须要调整下prompt或者使用工作流去处理","like_count":1},{"had_liked":false,"id":405769,"user_name":"法正","can_delete":false,"product_type":"c3","uid":1052578,"ip_address":"浙江","ucode":"1DA674D3B87181","user_header":"https://static001.geekbang.org/account/avatar/00/10/0f/a2/df265969.jpg","comment_is_top":false,"comment_ctime":1772779529,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":101114301,"comment_content":"课程很好！！！","like_count":1},{"had_liked":false,"id":405739,"user_name":"Rye","can_delete":false,"product_type":"c3","uid":1175100,"ip_address":"北京","ucode":"5BDC40ED641A6C","user_header":"https://static001.geekbang.org/account/avatar/00/11/ee/3c/a2b67971.jpg","comment_is_top":false,"comment_ctime":1772711966,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":101114301,"comment_content":"关于架构的决策之前比较粗糙，就是当前的资源有哪些，以及当前的知识能力可以做到什么程度，也确实基本都是 prompt和workflow加RAG为主，信息技术迭代太快，产品的迭代速度也有点跟不上，目前正在朝Agent和Muti落地努力，感谢老师。","like_count":1},{"had_liked":false,"id":405496,"user_name":"maybe","can_delete":false,"product_type":"c3","uid":1475528,"ip_address":"广西","ucode":"93D160F617E750","user_header":"https://static001.geekbang.org/account/avatar/00/16/83/c8/5ce842f6.jpg","comment_is_top":false,"comment_ctime":1772027190,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":101114301,"comment_content":"当时做的AI应用场景，仅仅是根据输入输出表单页面，表单支持的类型都是限定范围的，数据及其简单的场景，所以当时就只是使用Prompt范式完成，业务的不确定性和最终系统实现的复杂度是匹配的。","like_count":1},{"had_liked":false,"id":406700,"user_name":"树","can_delete":false,"product_type":"c3","uid":1045646,"ip_address":"上海","ucode":"8080E671F84C46","user_header":"https://static001.geekbang.org/account/avatar/00/0f/f4/8e/081c530c.jpg","comment_is_top":false,"comment_ctime":1775711360,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":101114301,"comment_content":"最后的阿什比定律 非常有启发， 赞\n- 输入不确定性\n- 过程不确定性\n- 结果不确定性","like_count":0},{"had_liked":false,"id":406149,"user_name":"Ares","can_delete":false,"product_type":"c3","uid":2027643,"ip_address":"北京","ucode":"DFB8FDCA0100D6","user_header":"https://static001.geekbang.org/account/avatar/00/1e/f0/7b/dadb931a.jpg","comment_is_top":false,"comment_ctime":1774177245,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":101114301,"comment_content":"我们公司最开始想做一个类似智能客服的Agent，但是可能会涉及到调取用户的数据、给用户做一些操作、回答用户的个性化问题，Agent回答的总是不太精准。慢慢的就变成了workflow+Agent形式，流程也长，Agent也不够智能。","like_count":0}]}