er_name":"虾米君","can_delete":false,"product_type":"c1","uid":2585585,"ip_address":"江苏","ucode":"3F48DE9BF10CC7","user_header":"https://static001.geekbang.org/account/avatar/00/27/73/f1/97c378d4.jpg","comment_is_top":false,"comment_ctime":1744854257,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":2,"product_id":100103401,"comment_content":"棒！","like_count":0},{"had_liked":false,"id":348115,"user_name":"无咎","can_delete":false,"product_type":"c1","uid":1479120,"ip_address":"","ucode":"B9759B5646F3AB","user_header":"https://static001.geekbang.org/account/avatar/00/16/91/d0/35bc62b1.jpg","comment_is_top":false,"comment_ctime":1654751680,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":2,"product_id":100103401,"comment_content":"为了制定学习计划，无意点进来最后一讲。说的好，不忘初心，自始至终。","like_count":0}]}