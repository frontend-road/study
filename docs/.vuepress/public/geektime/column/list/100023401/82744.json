FB6D","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":440883,"discussion_content":"1. 紧张的一个重要原因是敌对情绪 + 弱势自评，也就是把认为强势的一方看成是敌人。所以什么时候你不把对方当成强势的敌人了，紧张就能缓解大部分。打压快感等词说明潜意识里就已经把面试官推到对立面了。\n\n2. 面试官不是为了快感，而可能是在进行压力测试。看你在压力状态下是否还能高效冷静的表现。\n\n3. 如果面试官一直在这个你不懂的领域周旋，你可以坦诚相告自己在这块的能力和经验，并问询实际工作中对这块的要求程度，表明你的学习能力等，尽量消除你的差距带来的影响。在后面第24篇有提到。","content_length":240,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1551228307,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":79145,"user_name":"Nick","can_delete":false,"product_type":"c1","uid":1282000,"ip_address":"","ucode":"867054C5508F8A","user_header":"https://static001.geekbang.org/account/avatar/00/13/8f/d0/b6036b18.jpg","comment_is_top":false,"comment_ctime":1553384901,"is_pvip":false,"replies":[{"id":29101,"content":"不错，缘自内心的开放和自信👍","user_name":"作者回复","user_name_real":"海飞","uid":1173080,"ctime":1553563087,"ip_address":"","comment_id":79145,"utype":1}],"discussion_count":2,"race_medal":0,"score":2,"product_id":100023401,"comment_content":"我面试时，经常把面试官当成朋友，面试的过程当成和朋友交流技术问题的过程，这样能缓解紧张感。","like_count":5,"discussions":[{"author":{"id":1173080,"avatar":"https://static001.geekbang.org/account/avatar/00/11/e6/58/1c7f786a.jpg","nickname":"海飞","note":"","ucode":"C6B77418E1FB6D","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":444371,"discussion_content":"不错，缘自内心的开放和自信👍","content_length":14,"likes_number":1,"is_delete":false,"is_hidden":false,"ctime":1553563087,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":1,"child_discussions":[{"author":{"id":1707648,"avatar":"https://static001.geekbang.org/account/avatar/00/1a/0e/80/f8f91bae.jpg","nickname":"564321","note":"","ucode":"349D599741AB88","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":1173080,"avatar":"https://static001.geekbang.org/account/avatar/00/11/e6/58/1c7f786a.jpg","nickname":"海飞","note":"","ucode":"C6B77418E1FB6D","race_medal":0,"user_type":2,"is_pvip":false},"discussion":{"id":599205,"discussion_content":"这也正是这篇文章快结尾时老师提到的几个缓解紧张的小技巧","content_length":27,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1673402555,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":444371,"ip_address":"江苏","group_id":0,"attachments":[]},"score":599205,"extra":""}]}]},{"had_liked":false,"id":79326,"user_name":"小悟空","can_delete":false,"product_type":"c1","uid":1353190,"ip_address":"","ucode":"D9746597982990","user_header":"http://thirdwx.qlogo.cn/mmopen/vi_32/R2cqC8msBMeI9oX5MiamIg2WeqB6YlTQstMSx4Diafj5gdXJID0LRSLo75grdlVDVSjn1iaspeLWUnticbAoO9Jibhw/132","comment_is_top":false,"comment_ctime":1553435755,"is_pvip":false,"replies":[{"id":28938,"content":"不错的方法！如果躲避不开，就不如及早接触、熟悉和接受它。","user_name":"作者回复","user_name_real":"海飞","uid":1173080,"ctime":1553470066,"ip_address":"","comment_id":79326,"utype":1}],"discussion_count":2,"race_medal":0,"score":2,"product_id":100023401,"comment_content":"从很久以前就在使用的一个小技巧：如果对做一件事有恐惧感，就在一张纸上写下这件事可能产生的最坏结果。类似于脱敏治疗。","like_count":4,"discussions":[{"author":{"id":1173080,"avatar":"https://static001.geekbang.org/account/avatar/00/11/e6/58/1c7f786a.jpg","nickname":"海飞","note":"","ucode":"C6B77418E1FB6D","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":444454,"discussion_content":"不错的方法！如果躲避不开，就不如及早接触、熟悉和接受它。","content_length":28,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1553470066,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1479120,"avatar":"https://static001.geekbang.org/account/avatar/00/16/91/d0/35bc62b1.jpg","nickname":"无咎","note":"","ucode":"B9759B5646F3AB","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":670388,"discussion_content":"还有一点体会，能坦然接受最坏的结果，剩下的都比这好，也是有效的办法。","content_length":34,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1756188653,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"天津","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":71578,"user_name":"enjoylearning","can_delete":false,"product_type":"c1","uid":1000237,"ip_address":"","ucode":"DCAF8538DEA277","user_header":"","comment_is_top":false,"comment_ctime":1551374293,"is_pvip":false,"replies":[{"id":25727,"content":"嗯。面多了就熟悉了，就熟练了，不确定性就低了。","user_name":"作者回复","user_name_real":"海飞","uid":1173080,"ctime":1551403078,"ip_address":"","comment_id":71578,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100023401,"comment_content":"我觉得面的多了就不紧张了，表现会越来越好，当然降低期待很重要。","like_count":4,"discussions":[{"author":{"id":1173080,"avatar":"https://static001.geekbang.org/account/avatar/00/11/e6/58/1c7f786a.jpg","nickname":"海飞","note":"","ucode":"C6B77418E1FB6D","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":441217,"discussion_content":"嗯。面多了就熟悉了，就熟练了，不确定性就低了。","content_length":23,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1551403078,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":77988,"user_name":"小蜜蜂","can_delete":false,"product_type":"c1","uid":1360179,"ip_address":"","ucode":"5901FA3681B3AB","user_header":"https://static001.geekbang.org/account/avatar/00/14/c1/33/2864e394.jpg","comment_is_top":false,"comment_ctime":1553050142,"is_pvip":false,"replies":[{"id":29340,"content":"我碰到过不少应聘者，说跳槽原因是嫌上一家加班太多的。这句话不能孤立地看，要结合他的项目表现和贡献度来综合评价。\n\n如果这是个工作积极而且成果累累的人，想有一点自己的生活空间，有什么不可呢？生活一团糟的人，怎么能专心投入工作呢。\n\n可是，如果这位没有什么拿得出手的成果，甚至都给面试官一种不敬业的印象，他说想换个轻松点的工作，可想而知，面试官会怎么理解。\n\n其实即使应聘者自己不说出来，有些公司都会以工作生活平衡为卖点，吸引应聘者。但是，如果真的没有一点加班和挑战的工作，恐怕你也不会有什么成长。这就看个人情况去衡量了。","user_name":"作者回复","user_name_real":"海飞","uid":1173080,"ctime":1553698783,"ip_address":"","comment_id":77988,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100023401,"comment_content":"老师如果上一家公司加班太严重，离职就是想换个轻松一点，有自己的生活空间的公司，面试的时候，可以如实说吗？","like_count":3,"discussions":[{"author":{"id":1173080,"avatar":"https://static001.geekbang.org/account/avatar/00/11/e6/58/1c7f786a.jpg","nickname":"海飞","note":"","ucode":"C6B77418E1FB6D","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":443924,"discussion_content":"我碰到过不少应聘者，说跳槽原因是嫌上一家加班太多的。这句话不能孤立地看，要结合他的项目表现和贡献度来综合评价。\n\n如果这是个工作积极而且成果累累的人，想有一点自己的生活空间，有什么不可呢？生活一团糟的人，怎么能专心投入工作呢。\n\n可是，如果这位没有什么拿得出手的成果，甚至都给面试官一种不敬业的印象，他说想换个轻松点的工作，可想而知，面试官会怎么理解。\n\n其实即使应聘者自己不说出来，有些公司都会以工作生活平衡为卖点，吸引应聘者。但是，如果真的没有一点加班和挑战的工作，恐怕你也不会有什么成长。这就看个人情况去衡量了。","content_length":259,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1553698783,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":123967,"user_name":"求者上下","can_delete":false,"product_type":"c1","uid":1164955,"ip_address":"","ucode":"E8D8EFC5F4A21A","user_header":"https://static001.geekbang.org/account/avatar/00/11/c6/9b/bcbf9dc3.jpg","comment_is_top":false,"comment_ctime":1565785410,"is_pvip":false,"replies":[{"id":57156,"content":"是的，担心不确定性，想表现得更好。","user_name":"作者回复","user_name_real":"海飞","uid":1173080,"ctime":1573016847,"ip_address":"","comment_id":123967,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100023401,"comment_content":"大部分是担心自己没准备好而紧张","like_count":1,"discussions":[{"author":{"id":1173080,"avatar":"https://static001.geekbang.org/account/avatar/00/11/e6/58/1c7f786a.jpg","nickname":"海飞","note":"","ucode":"C6B77418E1FB6D","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":462925,"discussion_content":"是的，担心不确定性，想表现得更好。","content_length":17,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1573016847,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":118433,"user_name":"SteelHuaSheng","can_delete":false,"product_type":"c1","uid":1396126,"ip_address":"","ucode":"BC8127FC5207FC","user_header":"https://static001.geekbang.org/account/avatar/00/15/4d/9e/04ec08bf.jpg","comment_is_top":false,"comment_ctime":1564364820,"is_pvip":false,"replies":[{"id":57162,"content":"握手！","user_name":"作者回复","user_name_real":"海飞","uid":1173080,"ctime":1573017482,"ip_address":"","comment_id":118433,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100023401,"comment_content":"通过字里行间就能明显感觉到老师是在掏心窝子的讲和在写专栏的文章\n\n\n不用紧张，用心做好自己，有能力，有积累，真诚的表达出来，没什么好怕的。","like_count":1,"discussions":[{"author":{"id":1173080,"avatar":"https://static001.geekbang.org/account/avatar/00/11/e6/58/1c7f786a.jpg","nickname":"海飞","note":"","ucode":"C6B77418E1FB6D","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":460407,"discussion_content":"握手！","content_length":3,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1573017482,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":74699,"user_name":"Tzi","can_delete":false,"product_type":"c1","uid":1210725,"ip_address":"","ucode":"FF1998F370651B","user_header":"https://static001.geekbang.org/account/avatar/00/12/79/65/180c1d1f.jpg","comment_is_top":false,"comment_ctime":1552282792,"is_pvip":false,"replies":[{"id":27258,"content":"你是说找不到有说服力的原因解释为什么转前端？\n\n那你内心是怎么想的呢？是有前端的基础了？还是你看到转前端给你带来什么益处？有困惑？把相关的讲出来就好啦。","user_name":"作者回复","user_name_real":"海飞","uid":1173080,"ctime":1552303355,"ip_address":"","comment_id":74699,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":100023401,"comment_content":"老师， 我是后端最近2年工作偏前端，想转前端，面试应该怎么自我介绍","like_count":0,"discussions":[{"author":{"id":1173080,"avatar":"https://static001.geekbang.org/account/avatar/00/11/e6/58/1c7f786a.jpg","nickname":"海飞","note":"","ucode":"C6B77418E1FB6D","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":442657,"discussion_content":"你是说找不到有说服力的原因解释为什么转前端？\n\n那你内心是怎么想的呢？是有前端的基础了？还是你看到转前端给你带来什么益处？有困惑？把相关的讲出来就好啦。","content_length":76,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1552303355,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":71034,"user_name":"Being","can_delete":false,"product_type":"c1","uid":1152227,"ip_address":"","ucode":"80A8783927B650","user_header":"https://static001.geekbang.org/account/avatar/00/11/94/e3/ed118550.jpg","comment_is_top":false,"comment_ctime":1551250341,"is_pvip":false,"replies":[{"id":26167,"content":"嗯，展现自己的真实能力，该是你的，就是你的。:)","user_name":"作者回复","user_name_real":"海飞","uid":1173080,"ctime":1551574809,"ip_address":"","comment_id":71034,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":100023401,"comment_content":"突然有了点自信，选择是双向的，真实展现自己就好","like_count":0,"discussions":[{"author":{"id":1173080,"avatar":"https://static001.geekbang.org/account/avatar/00/11/e6/58/1c7f786a.jpg","nickname":"海飞","note":"","ucode":"C6B77418E1FB6D","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":440949,"discussion_content":"嗯，展现自己的真实能力，该是你的，就是你的。:)","content_length":24,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1551574809,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":199541,"user_name":"Ryoma","can_delete":false,"product_type":"c1","uid":1130590,"ip_address":"","ucode":"7F692369239692","user_header":"https://static001.geekbang.org/account/avatar/00/11/40/5e/b8fada94.jpg","comment_is_top":false,"comment_ctime":1585491174,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100023401,"comment_content":"面试紧张是正常情况，我以前校招的时候就特别容易紧张，随着工作经验的丰富，社招刚开始也特紧张，但随着提升自己，面试也会越来越自信。其实把面试看做是表现自己的机会，也是查漏补缺的机会，心态就会好很多。也可以没事出去面试，多练练。","like_count":6},{"had_liked":false,"id":281940,"user_name":"jon","can_delete":false,"product_type":"c1","uid":1045072,"ip_address":"","ucode":"E930ADF99502B2","user_header":"https://static001.geekbang.org/account/avatar/00/0f/f2/50/b9710b30.jpg","comment_is_top":false,"comment_ctime":1614959746,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":1,"score":3,"product_id":100023401,"comment_content":"吴军老师在格局这本书里说：“面试官也要承担很大的风险：无论是招进一个不合适的人，还是长时间招不到合适的人，他们所在单位的损失都很大，因此他们压力也很大，也希望短时间获得最有效信息，而不是为难面试者。”面试不是考试，而是人与人之间的交流与信息沟通…这样洗脑估计没那么紧张了……","like_count":4},{"had_liked":false,"id":235849,"user_name":"Jack MA","can_delete":false,"product_type":"c1","uid":1392508,"ip_address":"","ucode":"EB5BA04CCB7272","user_header":"https://static001.geekbang.org/account/avatar/00/15/3f/7c/e60c7d16.jpg","comment_is_top":false,"comment_ctime":1595222761,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100023401,"comment_content":"一个小技巧，面试的时候带上一瓶口香糖。面试前先嚼几颗。一来可以放松心情，二来可以保持口气清新。但要记得面试前吐掉，用纸巾包好。","like_count":3},{"had_liked":false,"id":267696,"user_name":"Richard","can_delete":false,"product_type":"c1","uid":2271138,"ip_address":"","ucode":"FE0CB58EB935EA","user_header":"","comment_is_top":false,"comment_ctime":1607875229,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100023401,"comment_content":"紧张的来源是大脑认为发现了危险，于是缓解紧张的关键就是不认为面试是对自己不利的。\n可以从三个方便思考 期待，能力，准备。\n1期待，我们需要找一份适合的工作，而不是非他不可的工作;\n2能力，表达能力+职位要求技能;\n3准备，了解职位+熟悉环境+面试技巧。","like_count":2},{"had_liked":false,"id":209247,"user_name":"许光伟","can_delete":false,"product_type":"c1","uid":1345056,"ip_address":"","ucode":"95976E241319BA","user_header":"https://static001.geekbang.org/account/avatar/00/14/86/20/ee7d32e0.jpg","comment_is_top":false,"comment_ctime":1587523239,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100023401,"comment_content":"写的太好了，我每次面试就是紧张的说不出来话，尝试看看上面的方法是不是可以帮到我","like_count":1},{"had_liked":false,"id":383341,"user_name":"ifelse","can_delete":false,"product_type":"c1","uid":2550743,"ip_address":"浙江","ucode":"D0565908C99695","user_header":"https://static001.geekbang.org/account/avatar/00/26/eb/d7/90391376.jpg","comment_is_top":false,"comment_ctime":1698894145,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":3,"score":3,"product_id":100023401,"comment_content":"面试只不过是一只开关，而能打开这个开关的，是你的能力，还有那么一丢丢运气的成分在。\n--记下来","like_count":0},{"had_liked":false,"id":336419,"user_name":"徐李","can_delete":false,"product_type":"c1","uid":1213325,"ip_address":"","ucode":"41550F6CA1E112","user_header":"https://static001.geekbang.org/account/avatar/00/12/83/8d/03cac826.jpg","comment_is_top":false,"comment_ctime":1646137945,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100023401,"comment_content":"在我校招找工作的时候能看到这篇文章就好了，那时候准备阿里的面试，在一个不合适的时间，不合适的地点，做了一个没有充分准备的不合适的面试，成了一直的遗憾。再之后，心态放平很多，对自己也很自信，就没有像当初那么紧张过了。","like_count":0},{"had_liked":false,"id":298119,"user_name":"Sam","can_delete":false,"product_type":"c1","uid":2264679,"ip_address":"","ucode":"DCF84B4D3A7354","user_header":"https://static001.geekbang.org/account/avatar/00/22/8e/67/afb412fb.jpg","comment_is_top":false,"comment_ctime":1623918079,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100023401,"comment_content":"明天的面试将会决定你今后三十年的命运，你会怎么样？紧张得一晚上睡不着觉，对不对？\n按照2年前的我看到这个纸条，是很紧张的，但是现在我看到这个纸条会这么想：\n就算失败了又怎么样哦，上帝关上这个窗，也会打另外一扇窗，毕竟上帝在屋内也想透入新鲜空气。孔子也用了自己的一生证明了自己不是当官的命，上天要他做万世师表。\n只要你认定这件事，就下苦功做，今天比昨天的自己有进步就好，不跟别人比，然后坚持不懈。","like_count":0},{"had_liked":false,"id":285171,"user_name":"夏尔","can_delete":false,"product_type":"c1","uid":1903283,"ip_address":"","ucode":"451B89FF60CF82","user_header":"https://static001.geekbang.org/account/avatar/00/1d/0a/b3/571ba4c4.jpg","comment_is_top":false,"comment_ctime":1616655021,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100023401,"comment_content":"可以和其他人闲聊或者问一些平常的小问题来制造交流机会，减少紧张感，增加对陌生场景的熟悉感。","like_count":0},{"had_liked":false,"id":258759,"user_name":"半橙汁","can_delete":false,"product_type":"c1","uid":1477902,"ip_address":"","ucode":"BB93BB9CCB7FA2","user_header":"https://static001.geekbang.org/account/avatar/00/16/8d/0e/5e97bbef.jpg","comment_is_top":false,"comment_ctime":1604550894,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100023401,"comment_content":"如今面试不会有当初那般紧张了，:\n        一方面是工作经验和经历的提升，让自我远离了初入社会的迷惘; \n        另一方面则是孰能生巧，一次次的面试经历总归是要好过第一次的。\n        从专栏中也学到了许多，结果固然重要，然而未来是有不确定性的，一次二次的结果，丝毫不会影响今后慢慢旅途的进度~","like_count":0},{"had_liked":false,"id":191669,"user_name":"小昭","can_delete":false,"product_type":"c1","uid":1326905,"ip_address":"","ucode":"149540DCFDF43E","user_header":"https://static001.geekbang.org/account/avatar/00/14/3f/39/a4c2154b.jpg","comment_is_top":false,"comment_ctime":1584788509,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100023401,"comment_content":"面试前可以自己做一些模拟面试做好准备。面试的时候先告诉自己，面的不好也没事儿。\n我自己经历来说的话，往往是期望越大失望越大，而那些不报期望的事儿，总会给我惊喜。（甚至是超越原本可能有的期望的惊喜）\n\n平时努力提高自己，不断学习。然后找到自己最舒服的状态，顺其自然就好啦。\n\n我大概是刚毕业的时候找工作会比较紧张，那时的紧张更多的来源于自己能力的不足。后来基本上不会再紧张了，一个是有了一些能力，另一个大概就是我比较随性，很多事情我没有那么看重。（太随性，好也不好）","like_count":0},{"had_liked":false,"id":166611,"user_name":"😳","can_delete":false,"product_type":"c1","uid":1452857,"ip_address":"","ucode":"9AFB87EF308539","user_header":"https://static001.geekbang.org/account/avatar/00/16/2b/39/19041d78.jpg","comment_is_top":false,"comment_ctime":1577518521,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100023401,"comment_content":"就像老师说的不要动机太强.不要想着必须通过面试,而是想成要是不过的话就当成一次经验吧,这样面试多了,也就不会有什么感觉了,以后面试会发挥的更好,而且面试是一个双向选择,不要给自己太多的压力,压力越大,紧张程度也越大,得不偿失.","like_count":0},{"had_liked":false,"id":161150,"user_name":"南琛一梦","can_delete":false,"product_type":"c1","uid":1030082,"ip_address":"","ucode":"6338D5428DB2B0","user_header":"https://static001.geekbang.org/account/avatar/00/0f/b7/c2/196932c7.jpg","comment_is_top":false,"comment_ctime":1576133116,"is_pvip":false,"replies":null,"discussion_count":1,"race_medal":0,"score":4,"product_id":100023401,"comment_content":"老师，请教一个问题：关于文中“内推的话，可以找推荐人了解该职位的真实工作细节和要求，以及此次面试的重点考核内容；“，朋友推荐去他们公司面试，但是他本人不在这个部门，所以这个点怎么去确认呢？","like_count":0,"discussions":[{"author":{"id":1479120,"avatar":"https://static001.geekbang.org/account/avatar/00/16/91/d0/35bc62b1.jpg","nickname":"无咎","note":"","ucode":"B9759B5646F3AB","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":670389,"discussion_content":"在一个公司也是收集到了有用的情报，让朋友去间接打听一下，也有一些效果。没有其它途径，还可以在面试中提问和面试后的分析总结。","content_length":61,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1756188973,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"天津","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":153942,"user_name":"Eleven","can_delete":false,"product_type":"c1","uid":1168452,"ip_address":"","ucode":"FB4A0C8CA732BE","user_header":"https://static001.geekbang.org/account/avatar/00/11/d4/44/0ec958f4.jpg","comment_is_top":false,"comment_ctime":1574334670,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100023401,"comment_content":"克服紧张最好的办法就是准备充分有了自信之后再去面，这是我的理解&gt;o&lt;","like_count":0},{"had_liked":false,"id":129426,"user_name":"厉害了我的国","can_delete":false,"product_type":"c1","uid":1052191,"ip_address":"","ucode":"CD0A54A1B998AA","user_header":"https://static001.geekbang.org/account/avatar/00/10/0e/1f/d0472177.jpg","comment_is_top":false,"comment_ctime":1567128193,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100023401,"comment_content":"写得真好","like_count":0},{"had_liked":false,"id":71277,"user_name":"枫暂","can_delete":false,"product_type":"c1","uid":1014069,"ip_address":"","ucode":"C68D26F42B2110","user_header":"https://static001.geekbang.org/account/avatar/00/0f/79/35/0f9fcaea.jpg","comment_is_top":false,"comment_ctime":1551315657,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100023401,"comment_content":"老师，能否给个关于这个专栏文章的目录或者说规划，这样我能提前了解到这个专栏第几期会出哪个方面的文章。最近在面试，想看看关于如何谈薪资这块的。","like_count":0},{"had_liked":false,"id":70918,"user_name":"Dark","can_delete":false,"product_type":"c1","uid":1087258,"ip_address":"","ucode":"5FED6E9E148195","user_header":"https://static001.geekbang.org/account/avatar/00/10/97/1a/97fdb4ce.jpg","comment_is_top":false,"comment_ctime":1551228016,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100023401,"comment_content":"自来熟","like_count":0}]}