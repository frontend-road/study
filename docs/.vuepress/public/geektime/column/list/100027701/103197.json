":9,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1566221838,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":107003,"user_name":"-W.LI-","can_delete":false,"product_type":"c1","uid":1210699,"ip_address":"","ucode":"3556786538664F","user_header":"https://static001.geekbang.org/account/avatar/00/12/79/4b/740f91ca.jpg","comment_is_top":false,"comment_ctime":1561436383,"is_pvip":false,"replies":[{"id":38752,"content":"会的，所以要及时清理","user_name":"作者回复","user_name_real":"Haoshuang","uid":1266132,"ctime":1561461974,"ip_address":"","comment_id":107003,"utype":1}],"discussion_count":4,"race_medal":0,"score":2,"product_id":100027701,"comment_content":"老师好学到了。通过threadlocal来减少锁竞争上下文切换的开销。\n可是我看见好多帖子说threadlocal容易内存泄露啥的肯比较多需要慎用。五年码龄从没用过😂。\n请教一个问题threadLocal中的对象如果用完不清。下次别的请求Tomcat线程池中拿到同个线程，能取到之前请求存入的数据么?","like_count":5,"discussions":[{"author":{"id":1266132,"avatar":"http://thirdwx.qlogo.cn/mmopen/vi_32/Q0j4TwGTfTIqtPHYrZKKTPAC2uSGwxZOwrN3qxcrcvMxEBzzE0QZf2vHfm17PuNvn5gLIOoPEFc7bOoOVxQQTw/132","nickname":"Haoshuang","note":"","ucode":"78B2EE7E09A029","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":455321,"discussion_content":"会的，所以要及时清理","content_length":10,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1561461974,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1178651,"avatar":"https://static001.geekbang.org/account/avatar/00/11/fc/1b/7fa5823c.jpg","nickname":"在下令狐冲","note":"","ucode":"6228893CCF8C09","race_med