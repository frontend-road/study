r_header":"https://static001.geekbang.org/account/avatar/00/12/18/34/c082419c.jpg","comment_is_top":false,"comment_ctime":1541135914,"is_pvip":false,"replies":[{"id":13208,"content":"一般都是先写数据库再写缓存，以数据库的操作为准","user_name":"作者回复","user_name_real":"古月中心相心","uid":1010144,"ctime":1541425467,"ip_address":"","comment_id":36509,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100014401,"comment_content":"如何做到缓存与数据库一致呢，缓存数据库不一致如何处理呢，写操作如果只写成功了缓存，数据以谁为呢？","like_count":3,"discussions":[{"author":{"id":1010144,"avatar":"https://static001.geekbang.org/account/avatar/00/0f/69/e0/fd4e4c19.jpg","nickname":"胡忠想","note":"","ucode":"0792605FC265B4","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":427895,"discussion_content":"一般都是先写数据库再写缓存，以数据库的操作为准","content_length":23,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1541425467,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":36275,"user_name":"每天晒白牙","can_delete":false,"product_type":"c1","uid":1004698,"ip_address":"","ucode":"A1B102CD933DEA","user_header":"https://static001.geekbang.org/account/avatar/00/0f/54/9a/76c0af70.jpg","comment_is_top":false,"comment_ctime":1541030954,"is_pvip":false,"replies":[{"id":13477,"content":"1.确实有这个问题，在异常情况下要靠缓存来扛。\n2.实时同步只能是靠强一致性的解决方案，这样业务性能肯定会有一定影响，代码复杂度也会增加不少，阿里和腾讯都有自己的成熟方案，可以去看看。","user_name":"作者回复","user_name_real":"古月中心相心","uid":1010144,"ctime":1541643892,"ip_address":"","comment_id":36275,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100014401,"comment_content":"看完有两个疑惑点\n1.独立机房部署的情况，虽然通过WMB在两个机房之间就行数据同步，但都只更新缓存，更新数据库还是由主库更新，然后通过binlog同步给从库，如果主库有问题，从库并未写数据库只是写了缓存，数据库中数据就不会更新了，只有缓存来扛。\n2.关于一致性问题，文章给出的方案是通过定时任务每分钟在es中扫描requestid相同机房不同的处理状态信息，判断是否一致，不一致的进行充实直到一直，这种也是最终一致性，阿忠伯有啥准实时同步的方案吗？\n我都留了好多言了，阿忠伯从不回复我😂","like_count":2,"discussions":[{"author":{"id":1010144,"avatar":"https://static001.geekbang.org/account/avatar/00/0f/69/e0/fd4e4c19.jpg","nickname":"胡忠想","note":"","ucode":"0792605FC265B4","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":427810,"discussion_content":"1.确实有这个问题，在异常情况下要靠缓存来扛。\n2.实时同步只能是靠强一致性的解决方案，这样业务性能肯定会有一定影响，代码复杂度也会增加不少，阿里和腾讯都有自己的成熟方案，可以去看看。","content_length":92,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1541643892,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":36286,"user_name":"明天更美好","can_delete":false,"product_type":"c1","uid":1180696,"ip_address":"","ucode":"F036B8718938BE","user_header":"https://static001.geekbang.org/account/avatar/00/12/04/18/4b02510f.jpg","comment_is_top":false,"comment_ctime":1541031828,"is_pvip":false,"replies":[{"id":13212,"content":"我上面说得通过对账机制就是一种方案","user_name":"作者回复","user_name_real":"古月中心相心","uid":1010144,"ctime":1541425880,"ip_address":"","comment_id":36286,"utype":1}],"discussion_count":2,"race_medal":0,"score":2,"product_id":100014401,"comment_content":"胡老师，请教个问题，我们对性能有要求，所以数据全量缓存分布式缓存中，通过消息异步更新库，数据库是分布式的。需要携带分片键。所以性能一搬。故而全量缓存。但是数据有差异，怎么做到最终一致性呢","like_count":1,"discussions":[{"author":{"id":1010144,"avatar":"https://static001.geekbang.org/account/avatar/00/0f/69/e0/fd4e4c19.jpg","nickname":"胡忠想","note":"","ucode":"0792605FC265B4","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":427815,"discussion_content":"我上面说得通过对账机制就是一种方案","content_length":17,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1541425880,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1066752,"avatar":"https://static001.geekbang.org/account/avatar/00/10/47/00/3202bdf0.jpg","nickname":"piboye","note":"","ucode":"7CFD8712857A85","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":313043,"discussion_content":"事务补偿消息的方式，可以做到最终一致吧？","content_length":20,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1602922522,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":230240,"user_name":"秋天的透明雨🌧️","can_delete":false,"product_type":"c1","uid":1110437,"ip_address":"","ucode":"9363B49BFA6C14","user_header":"https://static001.geekbang.org/account/avatar/00/10/f1/a5/6cc9f728.jpg","comment_is_top":false,"comment_ctime":1593324017,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":2,"product_id":100014401,"comment_content":"有些术语缩写不是很懂，网上搜了一下，不知道对不对，请老师指正。WMB=Weibo Message Broker，MCQ=MemCache Queue(SimpleQueue Service Over Memcache)","like_count":4},{"had_liked":false,"id":115535,"user_name":"xylsh","can_delete":false,"product_type":"c1","uid":1140811,"ip_address":"","ucode":"C5A6A9B386B530","user_header":"https://thirdwx.qlogo.cn/mmopen/vi_32/sThqLZib1Tzjp0jiaWJvkSN8icmQFAlQXh5u2nBREmxETcppgRKv6uyRS3Kx5dYmIBpMz5A2wCpbdWVrBXx4xNmnw/132","comment_is_top":false,"comment_ctime":1563613973,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":2,"product_id":100014401,"comment_content":"写操作可能是有先后顺序的，比如a b c 3个写操作需要按照顺序写入，a c成功，b失败，定时线程重试b的时候，会导致c操作好的结果不正确，这种情况怎么处理的？","like_count":3},{"had_liked":false,"id":78816,"user_name":"Enjoystudy","can_delete":false,"product_type":"c1","uid":1028212,"ip_address":"","ucode":"179ECDFA5F518B","user_header":"https://static001.geekbang.org/account/avatar/0.png","comment_is_top":false,"comment_ctime":1553245896,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100014401,"comment_content":"多机房部署有个很重要的原则就是通过路由策略保证同一个用户的请求（至少写请求）打到同一个机房，尽量避免多个机房同时写数据导致的各种问题，在入口处和RPC的时候都需要做路由","like_count":2},{"had_liked":false,"id":268607,"user_name":"阿毅","can_delete":false,"product_type":"c1","uid":1126482,"ip_address":"","ucode":"5B006F905A1FDE","user_header":"https://static001.geekbang.org/account/avatar/00/11/30/52/7880dcf0.jpg","comment_is_top":false,"comment_ctime":1608272247,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100014401,"comment_content":"想请教几个问题：\n1）独立机房架构，如果写数据库和写缓存的那套机房挂掉，另外一套机房如何变成即写数据库又写缓存；\n2）请求是如何同时发给处理机 和 WMB ，不能在处理机这边 将请求发给 WMB；","like_count":1},{"had_liked":false,"id":104165,"user_name":"钱","can_delete":false,"product_type":"c1","uid":1009652,"ip_address":"","ucode":"2C92A243A463D4","user_header":"https://static001.geekbang.org/account/avatar/00/0f/67/f4/9a1feb59.jpg","comment_is_top":false,"comment_ctime":1560672719,"is_pvip":false,"replies":null,"discussion_count":1,"race_medal":0,"score":3,"product_id":100014401,"comment_content":"看结构图是强依赖缓存的，如果电信的缓存挂了，对应的服务是否就不可用了？还是此时能切到联通去？\n分布式系统的数据一致性是个难题，做到强一致更加复杂。\n赶集思路就是这两种啦：\n1：单写\n2：多写+同步\n       同步可以日志、MQ、RPC","like_count":1,"discussions":[{"author":{"id":1229501,"avatar":"https://static001.geekbang.org/account/avatar/00/12/c2/bd/18449753.jpg","nickname":"Wenfei","note":"","ucode":"AC6F45FF4146FA","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},