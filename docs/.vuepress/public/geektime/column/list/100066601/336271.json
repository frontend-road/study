_number":1,"is_delete":false,"is_hidden":false,"ctime":1617887895,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]},{"author":{"id":3253354,"avatar":"https://thirdwx.qlogo.cn/mmopen/vi_32/sgEfkeMSIIibeH4l0HS8uwGB5PKKDCLgo0RbV8QTfY6am1OYxBEY8g74WUnWkWl9azUX5XqvcbrMxSxmJXSibCcw/132","nickname":"Geek_23daec","note":"","ucode":"8ACB09D4FEEDF8","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":600831,"discussion_content":"同问这一步怎么求的？如果是频数/次数，代入是2/15=0.13，但老师为什么说是0.2呢？不明白","content_length":48,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1674899171,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"江苏","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1194344,"avatar":"https://static001.geekbang.org/account/avatar/00/12/39/68/5f4894b6.jpg","nickname":"Tays","note":"","ucode":"1211AEF35C958E","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":358708,"discussion_content":"前提 垃圾评论，所以 您好的概率是 2/15=0.13","content_length":27,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1616033447,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1480782,"avatar":"https://static001.geekbang.org/account/avatar/00/16/98/4e/f42d27e8.jpg","nickname":"Rosa rugosa","note":"","ucode":"A26068A69D7E9B","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","n