mber":0,"child_discussions":[]}]},{"had_liked":false,"id":297984,"user_name":"arronK","can_delete":false,"product_type":"c1","uid":1192961,"ip_address":"","ucode":"58DC6FBF2CF0C1","user_header":"https://static001.geekbang.org/account/avatar/00/12/34/01/30ca98e6.jpg","comment_is_top":false,"comment_ctime":1623859461,"is_pvip":false,"replies":null,"discussion_count":1,"race_medal":0,"score":2,"product_id":100081501,"comment_content":"一句话概括: 用输出倒逼输入。（具体理论也可以参考学习金字塔模型）","like_count":51,"discussions":[{"author":{"id":1245522,"avatar":"https://static001.geekbang.org/account/avatar/00/13/01/52/0a9d6073.jpg","nickname":"richard","note":"","ucode":"C1ABB3023DF1C3","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":607906,"discussion_content":"费曼学习法","content_length":5,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1678184843,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"北京","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":298655,"user_name":"黄矢","can_delete":false,"product_type":"c1","uid":1136224,"ip_address":"","ucode":"7ADD89AB9380AD","user_header":"https://static001.geekbang.org/account/avatar/00/11/56/60/fb5ca9e5.jpg","comment_is_top":false,"comment_ctime":1624251631,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":2,"product_id":100081501,"comment_content":"重复阅读只是获得熟悉感而不是知识，更好的方法是先给自己时间回想，锻炼锻炼自己的神经，做到真正用脑","like_count":12},{"had_liked":false,"id":300654,"user_name":"海阔天空","can_delete":false,"product_type":"c1","uid":1551443,"ip_address":"","ucode":"C3711704A3637D","user_header":"https://static001.geekbang.org/account/avatar/00/17/ac/53/ddbe4d80.jpg","comment_is_top":false,"comment_ctime":1625290008,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":2,"product_id":100081501,"comment_content":"学知识的主要目的就是使用，什么时候使用效果最好呢，就是刚刚学完的时候，一是此时记住的内容还比较多，二是此时正好可以在使用的同时加深对知识的记忆和理解程度。所以即学即用是快速掌握知识的一个途径，对于程序员来说就是学完就要独立敲出对应代码。同时还要不断回顾学习内容，回顾的过程不要碰到想不到的就赶紧翻资料看，而是通过检索式方式努力尝试回想学习内容，回想的过程也是加深印象的过程","like_count":7},{"had_liked":false,"id":299208,"user_name":"manx00","can_delete":false,"product_type":"c1","uid":1014356,"ip_address":"","ucode":"CA086E73F179E2","user_header":"https://static001.geekbang.org/account/avatar/00/0f/7a/54/497b1764.jpg","comment_is_top":false,"comment_ctime":1624513114,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":2,"product_id":100081501,"comment_content":"个人总结：\n\n考试是输出思维、学习是输入思维，两个是不同的事情\n需要研究考试题才能更好的知道怎样去学习\n研究考试题答案，才能知道怎样得到高分\n”即学即用“和”即用即学“都做到了才能对知识点有透彻的理解\n检索式学习是最有效的学习方式，回想知识点，付出的努力越大，学习和记忆的效果越好\n\n检索式学习和费曼学习法很像\n这篇文章看起来是学习怎样考试，实际上是学习怎样更好掌握知识点，考试得高分只是顺带的结果","like_count":6},{"had_liked":false,"id":297949,"user_name":"码上生长","can_delete":false,"product_type":"c1","uid":1089469,"ip_address":"","ucode":"6542E27AC85C7A","user_header":"https://static001.geekbang.org/account/avatar/00/10/9f/bd/b9c0300e.jpg","comment_is_top":false,"comment_ctime":1623852012,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":2,"product_id":100081501,"comment_content":"以终为始","like_count":4},{"had_liked":false,"id":321680,"user_name":"Geek_jiange","can_delete":false,"product_type":"c1","uid":1342746,"ip_address":"","ucode":"CBF5B8B77360C6","user_header":"https://static001.geekbang.org/account/avatar/00/14/7d/1a/a4a96b4d.jpg","comment_is_top":false,"comment_ctime":1636990212,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":2,"product_id":100081501,"comment_content":"- 面试其实也是一种考试。可以先收集该方向（操作系统，计算机网络，MySQL，Redis等）常见考题，大致浏览了解会考什么内容，后续学习或者阅读该方向知识的时候，才能知道哪些是考点，有助于加深印象。\n- 即用即学和即学即用都可以帮助加深记忆和理解。\n- 当忘记某个知识点的时候，尽可能去尝试想出来，实在想不出来再看答案，这样可以加深印象。","like_count":3},{"had_liked":false,"id":321162,"user_name":"LHStudy","can_delete":false,"product_type":"c1","uid":2702634,"ip_address":"","ucode":"B891C442B464E9","user_header":"https://thirdwx.qlogo.cn/mmopen/vi_32/Wq3hu4hkad1RPWGX5wYkAIOQ4kibNbk05jhGnzy2WkNOz0xUQUaVzyckPm1mibpjNDstofuuNDOPqoq73NFcla7g/132","comment_is_top":false,"comment_ctime":1636695584,"is_pvip":false,"replies":null,"discussion_count":1,"race_medal":0,"score":3,"product_id":100081501,"comment_content":"如果一个问题你不会，先不要去看答案，也别去请教别人。先试试自己去思考，哪怕最后你得出了错误的答案，甚至根本就没有做出来，但这个过程，会帮助你更好地理解这一题，掌握这一块的知识点。\n\n我基本上是遇到问题马上上网搜索答案。有时候也会自己思考，得到错误答案。\n下次再遇上同样的问题，印象最深的是自己得出的错误答案😅","like_count":3,"discussions":[{"author":{"id":2901316,"avatar":"https://static001.geekbang.org/account/avatar/00/2c/45/44/8df79d3c.jpg","nickname":"事已至此开始撤退","note":"","ucode":"1076FDF53DA81D","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":611685,"discussion_content":"666","content_length":3,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1680243361,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"上海","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":352377,"user_name":"MClink","can_delete":false,"product_type":"c1","uid":1435733,"ip_address":"","ucode":"F479190923355C","user_header":"https://static001.geekbang.org/account/avatar/00/15/e8/55/63189817.jpg","comment_is_top":false,"comment_ctime":1658622090,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100081501,"comment_content":"有好的学习方法才能事半功倍\n所以有些人其实是在瞎努力，方向不对","like_count":2},{"had_liked":false,"id":336357,"user_name":"woJA1wCgAAM2kpzxLmcpyL6995EJUhvA","can_delete":false,"product_type":"c1","uid":2927147,"ip_address":"","ucode":"209CF3D585D51B","user_header":"","comment_is_top":false,"comment_ctime":1646108920,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100081501,"comment_content":"广义来讲，就是人类的知识很多，只能学习自己需要的部分，狭义来说，对于你将来的工作，你要知道你需要哪些知识，有针对性的去学习，不要做无用功！——以上是我自己的理解","like_count":2},{"had_liked":false,"id":306542,"user_name":"清水透","can_delete":false,"product_type":"c1","uid":2732221,"ip_address":"","ucode":"8F6789A9DFFF13","user_header":"https://static001.geekbang.org/account/avatar/00/29/b0/bd/642a2a71.jpg","comment_is_top":false,"comment_ctime":1628602444,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100081501,"comment_content":"先看目录和大纲，带着问题去看，合上书本尝试用自己的语言来回答问题。这可能就是我需要的。","like_count":2},{"had_liked":false,"id":305318,"user_name":"Geek_4cabb4","can_delete":false,"product_type":"c1","uid":2688307,"ip_address":"","ucode":"016178BA8C4D85","user_header":"","comment_is_top":false,"comment_ctime":1627904124,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100081501,"comment_content":"还是要学会输出啊，要试着输出，最近在家里和妈妈聊天的时候就发现，自己像是茶壶里煮饺子——倒不出来。自己知道，但是语言上组织不起来，或者很难让别人感同身受。要多多练习，并且刻意的联系。难，难才要迎难而上。","like_count":2},{"had_liked":false,"id":298254,"user_name":"序章","can_delete":false,"product_type":"c1","uid":1304938,"ip_address":"","ucode":"7B05D63C2B86BC","user_header":"https://static001.geekbang.org/account/avatar/00/13/e9/6a/9e86914c.jpg","comment_is_top":false,"comment_ctime":1623982949,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100081501,"comment_content":"遇到问题-通过问题去学习新的知识点-遇到更多的问题","like_count":2},{"had_liked":false,"id":385602,"user_name":"吴亮","can_delete":false,"product_type":"c1","uid":2397945,"ip_address":"广东","ucode":"CEB3995975654C","user_header":"https://static001.geekbang.org/account/avatar/00/24/96/f9/e52955e1.jpg","comment_is_top":false,"comment_ctime":1702962428,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100081501,"comment_content":"怎么给自己提问题呢？比如我学习了爆款文案，该如何提问题，测试呢？","like_count":1},{"had_liked":false,"id":383052,"user_name":"铭源","can_delete":false,"product_type":"c1","uid":1394697,"ip_address":"上海","ucode":"EBFAA1D7A0FCF8","user_header":"https://static001.geekbang.org/account/avatar/00/15/48/09/e11180e7.jpg","comment_is_top":false,"comment_ctime":1698375722,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100081501,"comment_content":"带着问题去寻找答案，这样学习更直接高效，但是也有弊端，根据自身情况选择学习方法","like_count":1},{"had_liked":false,"id":365644,"user_name":"范飞扬","can_delete":false,"product_type":"c1","uid":2721761,"ip_address":"上海","ucode":"A665DF46833A81","user_header":"https://static001.geekbang.org/account/avatar/00/29/87/e1/b3edcc09.jpg","comment_is_top":false,"comment_ctime":1672844341,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100081501,"comment_content":"从技术人的观点出发，面试就是考试：\n1. 用面试的思维去学习\n2. 研究面试题，包括出题范围和思路\n3. 即用即学：写代码发现需要访问DB，学MyBatis&#47;GORM怎么用\n即学即用：学了GORM就拿来用用看\n4. “检索式练习”：直接跑出去面试，或者mock面试","like_count":1},{"had_liked":false,"id":346902,"user_name":"苏成","can_delete":false,"product_type":"c1","uid":2668694,"ip_address":"","ucode":"80A8E7B243DD73","user_header":"https://static001.geekbang.org/account/avatar/00/28/b8/96/716ba431.jpg","comment_is_top":false,"comment_ctime":1653529469,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100081501,"comment_content":"第二遍阅读产生的熟悉感会让我们误以为掌握了","like_count":1},{"had_liked":false,"id":321692,"user_name":"Layne","can_delete":false,"product_type":"c1","uid":1479934,"ip_address":"","ucode":"1FEAACD900AB39","user_header":"https://static001.geekbang.org/account/avatar/00/16/94/fe/5fbf1bdc.jpg","comment_is_top":false,"comment_ctime":1636995764,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100081501,"comment_content":"带着问题或目的性的去学习，往往比盲目性的学习更深切。\n有输出性的学习，更能检索自己学习的掌握程度，坚持有产出.\n","like_count":1},{"had_liked":false,"id":318706,"user_name":"小雨哥","can_delete":false,"product_type":"c1","uid":1451984,"ip_address":"","ucode":"D72D7A0EFFB72B","user_header":"https://static001.geekbang.org/account/avatar/00/16/27/d0/1a0ce02a.jpg","comment_is_top":false,"comment_ctime":1635398068,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100081501,"comment_content":"终局思维","like_count":1},{"had_liked":false,"id":314266,"user_name":"三千佛塔烟云下","can_delete":false,"product_type":"c1","uid":2273366,"ip_address":"","ucode":"79B45A1ABD077D","user_header":"https://static001.geekbang.org/account/avatar/00/22/b0/56/d3216fe2.jpg","comment_is_top":false,"comment_ctime":1632923706,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100081501,"comment_content":"1.背得滚瓜乱熟≠掌握知识。\n2.输出应该要比输入更多一些，&quot;检索式练习&quot;能强化知识点。可以说，输入是让知识进脑子，输出是将知识关在脑子里，不让它们偷偷跑掉。","like_count":1},{"had_liked":false,"id":303567,"user_name":"You","can_delete":false,"product_type":"c1","uid":2662969,"ip_address":"","ucode":"ACBDB82E9B39C4","user_header":"https://static001.geekbang.org/account/avatar/00/28/a2/39/3ee6f996.jpg","comment_is_top":false,"comment_ctime":1626858436,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100081501,"comment_content":"1、纠正学习和考试的正确关系。将知识点背熟不代表会考试，只能代表你很老实。\n2、明确“输入”和“输出”的关系。\n从考试的角度—&gt;“即学即用”。从考试习体来确定考察范围，揣测TA的出题来找到学习重点与方向，弄清楚怎么考，考什么，才可以“输出”怎么学。这个过程偏重于”输入”的过程，目的就是为了为“输出”导航\n从应用的角度—&gt;“即用即学“。就是落实”输出“的过程，通过“输入”得到的目标来进行“输出“，检索式学习，和要学习的内容打交道，这里希望你能成为一名”抬杠“的人，肯花时间和知识点耗上，想方设法让自己记忆知识点的理解更深刻。要注意：不要耗太久拖延时间，不行就认了去看答案。也不要过于钻牛角尖，因为违背了”输入“给定的目标，不必要的内容不要学，将功夫花在刀刃上。以上是”输出“的要点。\n3、最后总结，”即学即用“和”即用即学“相辅相成，”输入“：看试卷习体，得到考点后再看书；”输出“：针对考点用”检索式学习“来加深自己对知识点或是题型的印象。","like_count":1},{"had_liked":false,"id":405332,"user_name":"Geek_d480dd","can_delete":false,"product_type":"c1","uid":4426019,"ip_address":"上海","ucode":"C92FF1D0B18657","user_header":"","comment_is_top":false,"comment_ctime":1770977209,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100081501,"comment_content":"先明确目标，也就是考试的内容，再根据目标安排学习","like_count":0},{"had_liked":false,"id":404332,"user_name":"徐胜利","can_delete":false,"product_type":"c1","uid":2806544,"ip_address":"湖北","ucode":"9C3409E1363891","user_header":"https://static001.geekbang.org/account/avatar/00/2a/d3/10/e776c785.jpg","comment_is_top":false,"comment_ctime":1766659466,"is_pvip":true,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100081501,"comment_content":"一，考试思维\n学习模式（记忆知识点）：输入（知识点）-&gt;输出，误认为只要掌握得滚瓜烂熟、那么考场上自然什么题都会做\n考试模式（回想知识点）：输出-&gt;输入（知识点），根据问题反向查找知识点，给出具体答案\n\n二，研究试题\n带着问题去学习，会更加专注，理解更为深刻；即学即用\n研究方向（怎么考-&gt;怎么学）：\n1，考那些？（出题范围）\n2，是怎么考的？（出题方式，知识点掌握程度，如何运用知识点）\n3，如何答题？（答题标准，高分秘籍）\n4，培养哪些思维能力？（知识点联系能力，事件发展脉络理解能力）\n\n三，具体怎么做\n1，即用即学 &amp; 即学即用-&gt;活学活用\n即用即学：提问题-&gt;找答案，在实际场景中学习知识点\n\n2，检索式练习\n在复习的过程中，切忌一遍又一遍地重复阅读，这是低效方法，只是增加熟练感；\n好的做法，提问+主动回想，实在想不起来再看书或查阅笔记，增加大脑长时记忆\n\n深有同感，以前学习的时候就是一遍一遍的死记硬背，感觉都记住了，考试的时候老是做不好，而且记忆还不牢靠...","like_count":0},{"had_liked":false,"id":402955,"user_name":"🐒🐱🐭🐮🐯🐰🐶","can_delete":false,"product_type":"c1","uid":1189080,"ip_address":"北京","ucode":"52426AE36A9A39","user_header":"https://static001.geekbang.org/account/avatar/00/12/24/d8/aa41d743.jpg","comment_is_top":false,"comment_ctime":1760606369,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100081501,"comment_content":"谢谢 输入与输出是不同的 ","like_count":0},{"had_liked":false,"id":395345,"user_name":"gq2010","can_delete":false,"product_type":"c1","uid":1044599,"ip_address":"河南","ucode":"E0E09C40BD1E3C","user_header":"https://static001.geekbang.org/account/avatar/00/0f/f0/77/6c2103b1.jpg","comment_is_top":false,"comment_ctime":1730331798,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100081501,"comment_content":"我学习的时候，总是有抓紧把这门课赶快学完了的心态，课程太长了学着学着就没有耐心了。学完学完一课就会看看还有多少没学，导致自己只是为了学习而学习，课程学完收获却没多少。怎么克服这种心态啊？","like_count":0},{"had_liked":false,"id":393697,"user_name":"润曦","can_delete":false,"product_type":"c1","uid":1260277,"ip_address":"新加坡","ucode":"21D36F7DEEB43D","user_header":"https://static001.geekbang.org/account/avatar/00/13/3a/f5/1fa34f88.jpg","comment_is_top":false,"comment_ctime":1724642163,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100081501,"comment_content":"带着学习目的去学习，去探索，就会收获很大，如果没有目的，或者目的不明确，那就等于白学","like_count":0},{"had_liked":false,"id":378731,"user_name":"Geek_138112","can_delete":false,"product_type":"c1","uid":3678554,"ip_address":"广东","ucode":"03AFB085CDDAE6","user_header":"","comment_is_top":false,"comment_ctime":1690703815,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100081501,"comment_content":"技术人的面试就是一种典型的考试，想通过面试就要以考试的思维去准备\n1. 学习了某一模块，需要自行总结这一模块大致讲了什么，有什么特别核心的概念。主动发起回想，主动输出\n2. 研究面经，看看哪些知识点是常考、必考的，看看已经通过面试的人是怎么回答这些问题，总结相关元素\n3. 即学即用，学习了某个技术或某个特性，可以马上在本地环境进行测试\n4. 尝试在学习完一个模块后，用GPT给自己提问题，然后看看能不能用自己的话回答出来，达成检索式学习","like_count":0},{"had_liked":false,"id":373182,"user_name":"Frankzhang","can_delete":false,"product_type":"c1","uid":1017884,"ip_address":"北京","ucode":"5E80C66BC02CB7","user_header":"https://static001.geekbang.org/account/avatar/00/0f/88/1c/55d31f2f.jpg","comment_is_top":false,"comment_ctime":1682220609,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100081501,"comment_content":"计算机技术为例：\n需要按照面试的流程，去学习各种计算机技术；而不是拿到技术，从细节开始深扣每一个点。","like_count":0},{"had_liked":false,"id":368673,"user_name":"距离30米","can_delete":false,"product_type":"c1","uid":1516600,"ip_address":"四川","ucode":"5566D9AB9E47DE","user_header":"https://thirdwx.qlogo.cn/mmopen/vi_32/wBjvGCCZmO0Bic0DrnG466y6hwPkibGevAV6E6FPfQEricvw5toL7a2HSgjhI83cCiadrUibIyVibkgbbMOHVxo7HA8Q/132","comment_is_top":false,"comment_ctime":1676547924,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100081501,"comment_content":"哇，好有帮助，太感谢","like_count":0},{"had_liked":false,"id":366356,"user_name":"乐观的QAQ","can_delete":false,"product_type":"c1","uid":1880530,"ip_address":"广东","ucode":"2B94C6308EDE61","user_header":"https://static001.geekbang.org/account/avatar/00/1c/b1/d2/515ef48b.jpg","comment_is_top":false,"comment_ctime":1673604297,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100081501,"comment_content":"即用即学，以实践驱动学习，然后以学习的结果反作用于实践\n\n很像辩证唯物主义中的认识论，先实践再认识，再以实践检验认识，螺旋式上升，曲折式前进","like_count":0},{"had_liked":false,"id":361369,"user_name":"须臾","can_delete":false,"product_type":"c1","uid":2925839,"ip_address":"天津","ucode":"3B26D8A69929E0","user_header":"https://static001.geekbang.org/account/avatar/00/2c/a5/0f/65b86396.jpg","comment_is_top":false,"comment_ctime":1667452666,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100081501,"comment_content":"1.学习和考试，路径相反。学习的目标是记住所有的知识点。考试，最重要的是“输出”，主动回想和调取知识点，针对问题给出答案。要学会用考试的思维去学习。\n解决：去研究考试题，包括它的出题范围和出题思路，去分析考试时，题目要求你怎样回忆知识点、怎样运用知识点。然后，据此决定学习的时候，如何学，以及学什么。\n另外，最好能找到答案，你要知道高分的答案具有哪些元素，需要满足怎样的标准。\n注意：\n1.在学习的过程中，做到即用即学和即学即用，才能对知识点有透彻的理解和记忆，并且在考试中，做到更为高效准确地调取，以及运用。\n2.“检索式练习”通过提问和主动回想的方式，去巩固知识点。你在回想知识点的时候，所付出的认知努力越大，学习和记忆的效果就越好。(提取越难，记得越牢)","like_count":0},{"had_liked":false,"id":358328,"user_name":"春风百里","can_delete":false,"product_type":"c1","uid":1739292,"ip_address":"四川","ucode":"A42347996D2B85","user_header":"https://static001.geekbang.org/account/avatar/00/1a/8a/1c/f8ea6063.jpg","comment_is_top":false,"comment_ctime":1664199398,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100081501,"comment_content":"即学即用：学习后要去实践；\n即用即学：在实践中弥补不足；","like_count":0},{"had_liked":false,"id":349602,"user_name":"GeekPoplar","can_delete":false,"product_type":"c1","uid":1657079,"ip_address":"","ucode":"4D2412EB0661DD","user_header":"https://static001.geekbang.org/account/avatar/00/19/48/f7/de8e5ea9.jpg","comment_is_top":false,"comment_ctime":1656130607,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100081501,"comment_content":"本节关键词：检索式学习\n其实我更愿意称其为：面向实践的学习以及为实践服务的学习","like_count":0},{"had_liked":false,"id":344604,"user_name":"1900","can_delete":false,"product_type":"c1","uid":2559744,"ip_address":"","ucode":"D220C5A3256D0A","user_header":"https://static001.geekbang.org/account/avatar/00/27/0f/00/f0a497ce.jpg","comment_is_top":false,"comment_ctime":1651664979,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100081501,"comment_content":"以终为始 逆向思维","like_count":0},{"had_liked":false,"id":340155,"user_name":"...","can_delete":false,"product_type":"c1","uid":2726997,"ip_address":"","ucode":"572BE04404A9E2","user_header":"https://static001.geekbang.org/account/avatar/00/29/9c/55/4f92e8a9.jpg","comment_is_top":false,"comment_ctime":1648631143,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100081501,"comment_content":"我想问问，如果不认识知识点的情况下，是否应该先去认识知识点，然后再去用带着用考试的思维去学习，进行查漏补缺。因为我觉得如果不认识知识点的情况下，去看历年考试真题，怎么去分辨出这是考哪个知识点。所以我在想，用考试的思维去学习，适用于去对知识点有大概了解的情况下，使用会更好些？","like_count":0},{"had_liked":false,"id":334383,"user_name":"William Ning","can_delete":false,"product_type":"c1","uid":1592279,"ip_address":"","ucode":"4DB8D05E69E5F3","user_header":"https://static001.geekbang.org/account/avatar/00/18/4b/d7/f46c6dfd.jpg","comment_is_top":false,"comment_ctime":1644910105,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100081501,"comment_content":"赞同～～～ 每次都先认真思考，绞尽脑汁地思考，然后再去校对，反思，总结。","like_count":0},{"had_liked":false,"id":303255,"user_name":"赌神很低调","can_delete":false,"product_type":"c1","uid":1168545,"ip_address":"","ucode":"1066778E1EDF26","user_header":"https://static001.geekbang.org/account/avatar/00/11/d4/a1/8bc8e7e1.jpg","comment_is_top":false,"comment_ctime":1626688007,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100081501,"comment_content":"一句话概括:主动输出，测试所学","like_count":0},{"had_liked":false,"id":301980,"user_name":"信仰年轻","can_delete":false,"