se,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"河北","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":402614,"user_name":"云飞扬","can_delete":false,"product_type":"c3","uid":1001334,"ip_address":"美国","ucode":"B360910F95ED01","user_header":"https://static001.geekbang.org/account/avatar/00/0f/47/76/6e7bdcc1.jpg","comment_is_top":false,"comment_ctime":1758684866,"is_pvip":false,"replies":[{"id":146384,"content":"cursor现在的界面对比课程录制时做了一些改变。\n不太明白你说的直接编辑模式是什么意思。\n现在Cursor去掉了以前的Chat和Composer模式，改成了Ask和Agent。\nAsk模式相当于以前的Chat，并且可以不用@Codebase了，直接可以在Ask窗口中提问关于代码库的问题。\nAgent模式相当于以前Composer下的Agent。","user_name":"作者回复","user_name_real":"编辑","uid":1224950,"ctime":1759236533,"ip_address":"河北","comment_id":402614,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100855101,"comment_content":"cursor直接编辑模式在哪儿啊？只能用AI模式？","like_count":0,"discussions":[{"author":{"id":1224950,"avatar":"https://static001.geekbang.org/account/avatar/00/12/b0/f6/eb6a8f61.jpg","nickname":"郭旭","note":"","ucode":"7CC6787BD0F0A9","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":672251,"discussion_content":"cursor现在的界面对比课程录制时做了一些改变。\n不太明白你说的直接编辑模式是什么意思。\n现在Cursor去掉了以前的Chat和Composer模式，改成了Ask和Agent。\nAsk模式相当于以前的Chat，并且可以不用@Codebase了，直接可以在Ask窗口中提问关于代码库的问题。\nAgent模式相当于以前Composer下的Agent。","content_length":376,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1759236533,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"河北","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":401485,"user_name":"winterxxx","can_delete":false,"product_typ