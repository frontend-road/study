_type":"c3","uid":2809585,"ip_address":"安徽","ucode":"4C1CB88867FC6B","user_header":"https://static001.geekbang.org/account/avatar/00/2a/de/f1/843f45db.jpg","comment_is_top":false,"comment_ctime":1774071478,"is_pvip":false,"replies":[{"id":150973,"content":"异步其实为了是并发，可以理解为一个主线程执行主流程的过程中，创建了多个子线程一起跑某些子任务，然后等都跑完了主线程再拿到所有结果继续执行","user_name":"作者回复","user_name_real":"编辑","uid":1521002,"ctime":1774321323,"ip_address":"北京","comment_id":406121,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":101114301,"comment_content":"从老师的课程来看，面向大模型的编程，由于大模型输出时间时延的不确定性，通常需要通过异步方式执行，如何理解这里的异步设计的原则？ \n\n我觉得这种授课逻辑不错，一是写代码时间耗得长，第二是知道怎么写，让AI帮写也能解决问题。核心是讲清楚目标和实现过程的逻辑。我觉得这一点老师已经在课上完成的相当不错了，尽管我不是一个代码出身的同学","like_count":1,"discussions":[{"author":{"id":1521002,"avatar":"https://static001.geekbang.org/account/avatar/00/17/35/6a/7997de5a.jpg","nickname":"晓寒","note":"","ucode":"8BB0F59591B8CC","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":682682,"discussion_content":"异步其实为了是并发，可以理解为一个主线程执行主流程的过程中，创建了多个子线程一起跑某些子任务，然后等都跑完了主线程再拿到所有结果继续执行","content_length":204,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1774321324,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"北京","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":406847,"user_name":"浩仔是程序员","can_delete":false,"product_type":"c3","uid":1104601,"ip_address":"重庆","ucode":"A7E5CF9E1571A2","user_header":"https://static001.geekbang.org/account/avatar/00/10/da/d9/f051962f.jpg","comment_is_top":false,"comment_ctime":1776169930,"is_pvip":false,"replies":[{"id":151316,"content":"可以用skill，但是课程在这里还没教到skill先了解基础","user_name":"作者回复","user_name_real":"编辑","uid":1521002,"ctime":1776343874,"ip_address":"北京","comment_id":406847,"