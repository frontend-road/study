"product_type":"c1","uid":1525309,"ip_address":"福建","ucode":"D1007711CB0A79","user_header":"https://static001.geekbang.org/account/avatar/00/17/46/3d/55653953.jpg","comment_is_top":false,"comment_ctime":1741496787,"is_pvip":false,"replies":[{"id":144559,"content":"ollama是量化模型，就是把参数精度压缩了，模型变小了，所以快","user_name":"作者回复","user_name_real":"编辑","uid":1943646,"ctime":1741587648,"ip_address":"山东","comment_id":398501,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100995901,"comment_content":"我使用原生的部署Qwen时，和使用 ollam部署 qwen时，会出现：ollam生成的回复快于本地直接部署（很明显的对比）不知道是什么问题导致的？而且，我还是喜欢自主性强一些的，就是本地部署大模型，所以发现这个区别。清华大学的开源模型，我也发现会很忙，ollam是做了什么优化，还是去掉了某些东西？","like_count":10,"discussions":[{"author":{"id":1943646,"avatar":"https://static001.geekbang.org/account/avatar/00/1d/a8/5e/791d0f5e.jpg","nickname":"最后的风之子","note":"","ucode":"45D5487480A5D2","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":658272,"discussion_content":"ollama是量化模型，就是把参数精度压缩了，模型变小了，所以快","content_length":32,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1741587648,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"山东","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":398351,"user_name":"张申傲","can_delete":false,"product_type":"c1","uid":1182372,"ip_address":"北京","ucode":"22D46BC529BA8A","user_header":"https://static001.geekbang.org/account/avatar/00/12/0a/a4/828a431f.jpg","comment_is_top":false,"comment_ctime":1741087693,"is_pvip":false,"replies":[{"id":144507,"content":"说得太好了👏","user_name":"作者回复","user_name_real":"编辑","uid":1943646,"ctime":1741097530,"ip_address":"山东","comment_id":398351,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100995901,"comment_content":"个人觉