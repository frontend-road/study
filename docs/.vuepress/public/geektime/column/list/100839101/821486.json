code":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":654012,"discussion_content":"多谢补充","content_length":4,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1731661046,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"陕西","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":398514,"user_name":"伟大的疯狂","can_delete":false,"product_type":"c1","uid":2678793,"ip_address":"北京","ucode":"AE05DCF2D6C1FF","user_header":"https://static001.geekbang.org/account/avatar/00/28/e0/09/919e001e.jpg","comment_is_top":false,"comment_ctime":1741532953,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":2,"product_id":100839101,"comment_content":"LLM的原理就不得不提到self-attention了","like_count":2},{"had_liked":false,"id":398120,"user_name":"倔强的攻城狮","can_delete":false,"product_type":"c1","uid":2210253,"ip_address":"北京","ucode":"A903AA45C2D3BE","user_header":"https://static001.geekbang.org/account/avatar/00/21/b9/cd/5d383c8e.jpg","comment_is_top":false,"comment_ctime":1740533319,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100839101,"comment_content":"大模型的工作简单理解: 一次添加一个词（token）。\n文本等内容交给大模型处理前会被转化为向量，最终交给大模型来处理。\n转化为向量的过程叫做embending 一般包含两个步骤:\n①进行one-hot处理成向量\n②转换的向量进行压缩","like_count":1},{"had_liked":false,"id":395771,"user_name":"张申傲","can_delete":false,"product_type":"c1","uid":1182372,"ip_address":"北京","ucode":"22D46BC529BA8A","user_header":"https://static001.geekbang.org/account/avatar/00/12/0a/a4/828a431f.jpg","comment_is_top":false,"comment_ctime":1732017425,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100839101,"comment_content":"第2讲打卡~","like_count":1},{"had_liked":false,"id":395465,"user_name":"公号-技术夜未眠","can_delete":false,"product_type":"c1","uid":1013683,"ip_address":"四川","ucode":"83825B57CBD952","user_header":"https://static001.geekbang.org/account/avatar/00/0f/77/b3/991f3f9b.jpg","comment_is_top":false,"comment_ctime":1730895134,"is_pvip":true,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100839101,"comment_content":"流式输出","like_count":1},{"had_liked":false,"id":399764,"user_name":"一柄竹剑走天涯","can_delete":false,"product_type":"c1","uid":3163061,"ip_address":"北京","ucode":"499C29D09B4393","user_header":"https://static001.geekbang.org/account/avatar/00/30/43/b5/c3cf3ad9.jpg","comment_is_top":false,"comment_ctime":1745309235,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100839101,"comment_content":"原始输入文本拆分为 token，token 通过嵌入技术转为无语义的向量， embedding 是通过训练数据将部分向量转为带有语义信息的向量，这样理解它们之间的关系对吗？","like_count":0},{"had_liked":false,"id":398686,"user_name":"ifelse","can_delete":false,"product_type":"c1","uid":2550743,"ip_address":"浙江","ucode":"D0565908C99695","user_header":"https://static001.geekbang.org/account/avatar/00/26/eb/d7/90391376.jpg","comment_is_top":false,"comment_ctime":1741919383,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":3,"score":3,"product_id":100839101,"comment_content":"学习打卡","like_count":0},{"had_liked":false,"id":398171,"user_name":"渣渣左","can_delete":false,"product_type":"c1","uid":1248863,"ip_address":"湖北","ucode":"ACEB73277346CC","user_header":"http://thirdwx.qlogo.cn/mmopen/vi_32/DYAIOgq83equXYHzYnWw7vLxnnVh0wQCdMoDroVfJpicVZ1cA3MTaBuTRvlCzI3c0ou1ia9tsgr00Fjg5ljFweQQ/132","comment_is_top":false,"comment_ctime":1740667425,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100839101,"comment_content":"mark","like_count":0},{"had_liked":false,"id":398165,"user_name":"maybe","can_delete":false,"product_type":"c1","uid":1475528,"ip_address":"广西","ucode":"93D160F617E750","user_header":"https://static001.geekbang.org/account/avatar/00/16/83/c8/5ce842f6.jpg","comment_is_top":false,"comment_ctime":1740659727,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100839101,"comment_content":"token、temperature、embedding","like_count":0},{"had_liked":false,"id":397598,"user_name":"淡漠尘花划忧伤","can_delete":false,"product_type":"c1","uid":2311624,"ip_address":"陕西","ucode":"1F831CFB89C6A0","user_header":"https://static001.geekbang.org/account/avatar/00/23/45/c8/1ccbb110.jpg","comment_is_top":false,"comment_ctime":1739071227,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100839101,"comment_content":"重点总结：\n1. 大模型的工作很简单，一次添加一个词。Token 就是我们理解大模型编程的第一个重要概念。这个 Token 可能是我们传统理解的一个完整的单词，可能是一个单词组合，甚至可能是单词的一部分（这就是大模型可以“造出新词”的原因）。有一个很重要的指标就是上下文窗口（Context Window）的大小。这里的上下文窗口，指的就是大模型可以处理 Token 数量，上下文越大，能处理的 Token 越多。\n2. 表示随机性强弱的概念：温度它是表示大模型活跃程度的一个参数，通过调节这个参数，大模型变得更加活跃，或是更加死板。\n3. 大模型内部处理的并不是字符串，而是向量。之所以要将字符串转换为向量，简单理解，就是现在大部分的 AI 算法只支持向量。","like_count":0},{"had_liked":false,"id":397558,"user_name":"江旭东01","can_delete":false,"product_type":"c1","uid":1018278,"ip_address":"浙江","ucode":"15C77B1688B87F","user_header":"https://static001.geekbang.org/account/avatar/00/0f/89/a6/1fc5435f.jpg","comment_is_top":false,"comment_ctime":1738930247,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100839101,"comment_content":"上下文窗口的大小决定了大模型一次可以处理多少个 Token，什么决定上下文窗口的大小呢？","like_count":0},{"had_liked":false,"id":397550,"user_name":"Geek_d4f4e7","can_delete":false,"product_type":"c1","uid":4078798,"ip_address":"江西","ucode":"4B6DC842D30DA6","user_header":"","comment_is_top":false,"comment_ctime":1738908795,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":3,"product_id":100839101,"comment_content":"个人理解希望老师和其他同学帮我纠正一下\n本章主要大模型的核心，就是选择下一个词，针对回答的创新性更人性化更有温度，和我们讲了一下其中的一个参数叫做温度(随机性)。\n其次和我们简单介绍了一下Token，Token是大模型理解的文本的基本单位，在不同大模型中token可以为字符、单词、子词，Token也是大模型计费的标准\n其次和我们简单介绍了下字符串到向量的过程，和我们介绍了一下ai算法是基于向量进行运算，大模型会将字符串统一处理为向量，处理步骤有两步，第一步one-hot编码，将字符串处理为离散稀疏的高维向量，第二步把第一步结果进行压缩，将向量通过嵌入层矩阵压缩成低维密集向量","like_count":0}]}