y\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":225284,"user_name":"Y024","can_delete":false,"product_type":"c1","uid":1018056,"ip_address":"","ucode":"397126D2E17997","user_header":"https://static001.geekbang.org/account/avatar/00/0f/88/c8/6af6d27e.jpg","comment_is_top":false,"comment_ctime":1591705185,"is_pvip":false,"replies":[{"id":83105,"content":"由此可见，两个专栏是一个人写的。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1591794226,"ip_address":"","comment_id":225284,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100052601,"comment_content":"模型-&gt;接口-&gt;实现，这也是郑老师第一季专栏里结构化思维的一种体现，由全局到定向细节。","like_count":10,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":497795,"discussion_content":"由此可见，两个专栏是一个人写的。","content_length":16,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1591794226,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":274176,"user_name":"Geek_0315ca","can_delete":false,"product_type":"c1","uid":1810532,"ip_address":"","ucode":"675254A9FC25A8","user_header":"http://thirdwx.qlogo.cn/mmopen/vi_32/Q0j4TwGTfTKVAVOYIoohh3bCdgErne0VHtoPorcrtmOAR45rsWPmJsLkzlvqMulbRyv0Skj8JHajrA9bPia3Lxw/132","comment_is_top":false,"comment_ctime":1610890755,"is_pvip":false,"replies":[{"id":99889,"content":"这个比喻很有趣。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1611450412,"ip_address":"","comment_id":274176,"utype":1}],"discussion_count":2,"race_medal":0,"score":2,"product_id":100052601,"comment_content":"模型，接口，实现的概念映射到现实生活，类似参观动物王国，园区都会发一张园区导航图。导航图就是整个动物王国的模型，海洋馆，猛兽馆等就相当于接口，现实中的海洋馆和猛兽馆就相当于实现。在模型上展示的接口(海洋馆，猛兽馆)只是文档上的书面表示，看不出来它是用什么材料做的，占地面积。只有我们亲自到了才知道它是用水泥建的塔楼，还是水中的玻璃走廊。在海洋馆或猛兽馆门口都还会有一个导航图(模型)，告诉不同种类动物的位置(接口)，你按照导航图找到动物所在的位置(接口)，看到了想看动物(实现)","like_count":8,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":513931,"discussion_content":"这个比喻很有趣。","content_length":8,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1611450412,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1731543,"avatar":"https://static001.geekbang.org/account/avatar/00/1a/6b/d7/8872624a.jpg","nickname":"xmeng","note":"","ucode":"C0CA2182BA3B4B","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":407917,"discussion_content":"棒","content_length":1,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1635151007,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":223347,"user_name":"苦行僧","can_delete":false,"product_type":"c1","uid":1055334,"ip_address":"","ucode":"726024A9A9CF44","user_header":"https://static001.geekbang.org/account/avatar/00/10/1a/66/2d9db9ed.jpg","comment_is_top":false,"comment_ctime":1591067856,"is_pvip":false,"repl