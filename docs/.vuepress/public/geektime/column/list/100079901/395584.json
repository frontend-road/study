:false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1802107,"avatar":"https://static001.geekbang.org/account/avatar/00/1b/7f/7b/73012e0e.jpg","nickname":"杰龙","note":"","ucode":"9ABA4AD3BF81B1","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":545469,"discussion_content":"应该是走的批量更新, 所以只会执行最后一次","content_length":21,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1641969792,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]}]}]}