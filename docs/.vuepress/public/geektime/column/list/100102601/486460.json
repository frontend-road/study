can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":334471,"user_name":"烟火不坠","can_delete":false,"product_type":"c1","uid":1149539,"ip_address":"","ucode":"BEEE3173C66E5F","user_header":"https://static001.geekbang.org/account/avatar/00/11/8a/63/a5fda84d.jpg","comment_is_top":false,"comment_ctime":1644972555,"is_pvip":false,"replies":[{"id":122187,"content":"手机不需要对焦，这是手机最强大的优势～","user_name":"作者回复","user_name_real":"编辑","uid":1663285,"ctime":1644985805,"ip_address":"","comment_id":334471,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100102601,"comment_content":"按时追更🧐，下一篇老师难道要说手机的对焦了吗？","like_count":0,"discussions":[{"author":{"id":1663285,"avatar":"https://static001.geekbang.org/account/avatar/00/19/61/35/acc2ed75.jpg","nickname":"布步次里-Mai","note":"","ucode":"B1BA13EFFC82A2","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":551324,"discussion_content":"手机不需要对焦，这是手机最强大的优势～","content_length":19,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1644985805,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":334465,"user_name":"大帅","can_delete":false,"product_type":"c1","uid":1915263,"ip_address":"","ucode":"391E59B7A312AD","user_header":"https://static001.geekbang.org/account/avatar/00/1d/39/7f/3af0acad.jpg","comment_is_top":false,"comment_ctime":1644970935,"is_pvip":false,"replies":[{"id":122186,"content":"大光圈从来都不是为了突出主题的，大光圈是为了创造视觉效果的…对于绝大多数人来说，如果一个人用大光圈突出主题，大概率会拍出一张特别破的照片儿～","user_name":"作者回复","user_name_real":"编辑","uid":1663285,"ctime":1644985658,"ip_address":"","comment_id":334465,"utype":1}],"discussion_count":3,"race_medal":0,"score":2,"product_id":100102601,"comment_content":"老师，您也在第6封信中写道，您不喜欢虚化这个东西，虚化能弱一点是一点。\n不过，看到大家拍的人像照片，都是为了突出人物主题，用大光圈，背景都有一定程度虚化。那么，老师，拍摄人像的时候，是不是有必要的进行一定的背景虚化呢？\n谢谢\n","like_count":0,"discussions":[{"author":{"id":1663285,"avatar":"https://static001.geekbang.org/account/avatar/00/19/61/35/acc2ed75.jpg","nickname":"布步次里-Mai","note":"","ucode":"B1BA13EFFC82A2","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":551322,"discussion_content":"大光圈从来都不是为了突出主题的，大光圈是为了创造视觉效果的…对于绝大多数人来说，如果一个人用大光圈突出主题，大概率会拍出一张特别破的照片儿～","content_length":70,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1644985659,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":2,"child_discussions":[{"author":{"id":1915263,"avatar":"https://static001.geekbang.org/account/avatar/00/1d/39/7f/3af0acad.jpg","nickname":"大帅","note":"","ucode":"391E59B7A312AD","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":1663285,"avatar":"https://static001.geekbang.org/account/avatar/00/19/61/35/acc2ed75.jpg","nickname":"布步次里-Mai","note":"","ucode":"B1BA13EFFC82A2","race_medal":0,"user_type":2,"is_pvip":false},"discussion":{"id":551323,"discussion_content":"谢谢老师","content_length":4,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1644985765,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":551322,"ip_address":"","group_id":0,"attachments":[]},"score":551323,"extra":""},{"author":{"id":3969659,"avatar":"","nickname":"Geek_de6ec0","note":"","ucode":"4F5F973C04F7D0","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":1663285,"avatar":"https://static001.geekbang.org/account/avatar/00/19/61/35/acc2ed75.jpg","nickname":"布步次里-Mai","note":"","ucode":"B1BA13EFFC82A2","race_medal":0,"user_type":2,"is_pvip":false},"discussion":{"id":651987,"discussion_content":"“大光圈是为了创造视觉效果的”，这里有点抽象没明白，还想听你细讲，来晚了，不知道后面能不能看到相关的，我继续往后学！","content_length":58,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1727979205,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":551322,"ip_address":"江西","group_id":0,"attachments":[]},"score":651987,"extra":""}]}]}]}