97832,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100079601,"comment_content":"QA和QE感觉职责差不多，不理解为什么要区分开呢，一般公司貌似只叫QA，就一个测试团队","like_count":3,"discussions":[{"author":{"id":1167883,"avatar":"https://static001.geekbang.org/account/avatar/00/11/d2/0b/cdd0787a.jpg","nickname":"孔令飞","note":"","ucode":"8363EA4BD0AAF0","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":521945,"discussion_content":"区别挺大的。QE主要职责是测试。但质量保障不仅仅只有测试，比如发布流程规范，故障复盘，质量指标的建立等，都需要建立起来，这些一般会通过QA来建立。小公司区别倒不用这么清晰。","content_length":86,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1623820454,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":330221,"user_name":"Bosco","can_delete":false,"product_type":"c1","uid":1584512,"ip_address":"","ucode":"2DC13C2F0D469B","user_header":"https://thirdwx.qlogo.cn/mmopen/vi_32/DYAIOgq83eq9seFoiaYyr0d85YI1icW858qjODSUY062CSOwHdEXBukolicJ0eVVnp6Wr1SBsyKHBvWwWggN7ibQIw/132","comment_is_top":false,"comment_ctime":1641869238,"is_pvip":false,"replies":[{"id":120943,"content":"666","user_name":"作者回复","user_name_real":"编辑","uid":1167883,"ctime":1642433894,"ip_address":"","comment_id":330221,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100079601,"comment_content":"作者介绍的研发流程跟目前公司团队的研发流程基本一样","like_count":2,"discussions":[{"author":{"id":1167883,"avatar":"https://static001.geekbang.org/account/avatar/00/11/d2/0b/cdd0787a.jpg","nickname":"孔令飞","note":"","ucode":"8363EA4BD0AAF0","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":546844,"discussion_content":"666","content_length":3,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1642433894,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":322819,"user_name":"yandongxiao","can_delete":false,"product_type":"c1","uid":1017700,"ip_address":"","ucode":"D397F4DB0109C8","user_header":"https://static001.geekbang.org/account/avatar/00/0f/87/64/3882d90d.jpg","comment_is_top":false,"comment_ctime":1637601300,"is_pvip":false,"replies":[{"id":117688,"content":"《不能自动化的流程，都是阻碍效率的》总结很到位！","user_name":"作者回复","user_name_real":"编辑","uid":1167883,"ctime":1638362679,"ip_address":"","comment_id":322819,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100079601,"comment_content":"总结：\n    1. 软件研发流程涉及六个阶段：需求阶段、设计阶段、开发阶段、测试阶段、发布阶段、运营阶段。\n    2. 需求阶段，基本不关心；\n    3. 设计阶段：交互设计、视觉设计、技术设计、技术评审、排期；\n    4. 开发阶段：掌握 Makefile、Git FLow、gitlab CI，结合各种效率工具，打造高效的 CI 过程。\n    5. 测试阶段：提测报告、自测报告；\n    6. 发布阶段：资源申请，发布单，催审批、流量灰度或副本粒度灰度，自动化测试用例，回滚。\n\n不能自动化的流程，都是阻碍效率的","like_count":2,"discussions":[{"author":{"id":1167883,"avatar":"https://static001.geekbang.org/account/avatar/00/11/d2/0b/cdd0787a.jpg","nickname":"孔令飞","note":"","ucode":"8363EA4BD0AAF0","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":535170,"discussion_content":"《不能自动化的流程，都是阻碍效率的》总结很到位！","content_length":24,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1638362679,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":318024,"user_name":"Geek_b67d9f","can