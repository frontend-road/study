n_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"美国","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":406857,"user_name":"Jaising","can_delete":false,"product_type":"c1","uid":1037630,"ip_address":"安徽","ucode":"F68830B7B90F96","user_header":"https://static001.geekbang.org/account/avatar/00/0f/d5/3e/7f3a9c2b.jpg","comment_is_top":false,"comment_ctime":1776208090,"is_pvip":false,"replies":[{"id":151325,"content":"👍","user_name":"作者回复","user_name_real":"编辑","uid":1026224,"ctime":1776572534,"ip_address":"美国","comment_id":406857,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":101089301,"comment_content":"所以不管是 AI-First 还是 AI-native 都是要基于软件工程来的，CI&#47;CD 流畅引入 AI 自然就流畅，Workflow 都不通 AI 只会放大缺陷——赞同老师严谨的工程思维，有一些环节比如 PR、CD 在真正的商用软件上还是需要人工接管，否则 CC 源码泄露、API Key 泄露这样的事情就还会发生","like_count":0,"discussions":[{"author":{"id":1026224,"avatar":"https://static001.geekbang.org/account/avatar/00/0f/a8/b0/6f87ab08.jpg","nickname":"Tony Bai","note":"","ucode":"B6B08985F6FA89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":684364,"discussion_content":"👍","content_length":4,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1776572534,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"美国","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":405899,"user_name":"Geek_14beb8","can_delete":false,"product_type":"c1","uid":2294759,"ip_address":"广东","ucode":"5373748363D648","user_header":"","comment_is_top":false,"comment_ctime":1773251083,"is_pvip":false,"replies":[{"id":150821,"content":"现在的ai还没到达这篇结束语展望的那个程度。\n\n基于当前ai水平，还需要human in loop的。即人设置适当的检查点并review。\n\n比如在 plan.md 生成后停一下，由人类架构师进行 Critical Review。蓝图错了，后面跑再久也是南辕北辙。\n\n项目初始阶段，可以小步快跑。先看它能不能跑通第一个子模块。确认方向ok后，再逐步放手。","user_name":"作者回复","user_name_real":"编辑","uid":1026224,"ctime":1773545013,"ip_address":"美国","comment_id":405899,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":101089301,"comment_content":"“AI 自主工作：接下来，你起身去喝杯咖啡，投入到另一个更具创造性的架构设计会议中。而 AI Agent，则开始了它长达数小时、甚至十几小时的“无人值守”工作” 现实和AI的工作都会遇到的问题，就是你的需求不合理设计就是逻辑错乱的，他&#47;AI 做了大半天发现都不通怎么办。","like_count":0,"discussions":[{"author":{"id":1026224,"avatar":"https://static001.geekbang.org/account/avatar/00/0f/a8/b0/6f87ab08.jpg","nickname":"Tony Bai","note":"","ucode":"B6B08985F6FA89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":682353,"discussion_content":"现在的ai还没到达这篇结束语展望的那个程度。\n\n基于当前ai水平，还需要human in loop的。即人设置适当的检查点并review。\n\n比如在 plan.md 生成后停一下，由人类架构师进行 Critical Review。蓝图错了，后面跑再久也是南辕北辙。\n\n项目初始阶段，可以小步快跑。先看它能不能跑通第一个子模块。确认方向ok后，再逐步放手。","content_length":419,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1773545013,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"美国","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":405718,"user_name":"huogh","can_delete":false,"product_type":"c1","uid":1070025,"ip_address":"北京","ucode":"9E0373C477F05A","user_header":"https://static001.geekbang.org/account/avatar/00/10/53/c9/abb7bfe3.jpg","comment_is_top":false,"comment_ctime":1772679966,"is_pvip":false,"replies":[{"id":150738,"content":"抓大放小，只有新功能（Feature）或重大重构（Epic）必须走全套 SDD。\n\n小修改（Bugfix&#47;文案调整），可以直接让 AI 改 Code。\n\n如何同步（反向工程）？这是一个痛点。一种可尝试的实践是：当你直接改了 Code（比如因为紧急修复线上 Bug），事后你应该在一个新的 Session 中，用 @ 选中修改后的代码，指令 AI：“请根据这份最新代码的逻辑，反向更新对应的 spec.md 和 plan.md，保持文档与代码的一致性。” 让 AI 做脏\n活","user_name":"作者回复","user_name_real":"编辑","uid":1026224,"ctime":1772955534,"ip_address":"美国","comment_id":405718,"utype":1}],"discussion_count":1,"race_medal":0,"score":4,"product_id":101089301,"comment_content":"Bai老师，还有一个问题。如果一个新项目使用了SDD流程开发，那么所有的代码修改都要通过spec-plan-tasks-code这个流程让AI去写代码吗？还是说能直接让AI改代码？如果让AI直接改code，要怎么确保spec、plan、tasks同步呢？","like_count":0,"discussions":[{"author":{"id":1026224,"avatar":"https://static001.geekbang.org/account/avatar/00/0f/a8/b0/6f87ab08.jpg","nickname":"Tony Bai","note":"","ucode":"B6B08985F6FA89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":682037,"discussion_content":"抓大放小，只有新功能（Feature）或重大重构（Epic）必须走全套 SDD。\n\n小修改（Bugfix/文案调整），可以直接让 AI 改 Code。\n\n如何同步（反向工程）？这是一个痛点。一种可尝试的实践是：当你直接改了 Code（比如因为紧急修复线上 Bug），事后你应该在一个新的 Session 中，用 @ 选中修改后的代码，指令 AI：“请根据这份最新代码的逻辑，反向更新对应的 spec.md 和 plan.md，保持文档与代码的一致性。” 让 AI 做脏\n活","content_length":544,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1772955534,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"美国","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":405716,"user_name":"huogh","can_delete":false,"product_type":"c1","uid":1070025,"ip_address":"北京","ucode":"9E0373C477F05A","user_header":"https://static001.geekbang.org/account/avatar/00/10/53/c9/abb7bfe3.jpg","comment_is_top":false,"comment_ctime":1772678679,"is_pvip":false,"replies":[{"id":150739,"content":"现状好像是ui这一层还是需要人工介入进行设计的（我们团队还是有专职ui）。如果后续ai足够强，尤其是多模态这块，可能ai也可以根据纯文本 Spec 生成符合复杂审美的、定制化的 UI。也许现在就有，但这方面我了解的不多。","user_name":"作者回复","user_name_real":"编辑","uid":1026224,"ctime":1772955649,"ip_address":"美国","comment_id":405716,"utype":1}],"discussion_count":1,"race_medal":0,"score":4,"product_id":101089301,"comment_content":"老师，如果是一个全栈项目，不止有后端，还有前端和app，前端的UI要怎么应用到SDD流程里呢？是让AI根据spec生成UI，还是需要设计师设计完UI，给AI参照实现代码？","like_count":0,"discussions":[{"author":{"id":1026224,"avatar":"https://static001.geekbang.org/account/avatar/00/0f/a8/b0/6f87ab08.jpg","nickname":"Tony Bai","note":"","ucode":"B6B08985F6FA89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":682038,"discussion_content":"现状好像是ui这一层还是需要人工介入进行设计的（我们团队还是有专职ui）。如果后续ai足够强，尤其是多模态这块，可能ai也可以根据纯文本 Spec 生成符合复杂审美的、定制化的 UI。也许现在就有，但这方面我了解的不多。","content_length":296,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1772955649,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"美国","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":405539,"user_name":"Geek_dc48d4","can_delete":false,"product_type":"c1","uid":1478564,"ip_address":"广东","ucode":"6F2104F88E3072","user_header":"http://thirdwx.qlogo.cn/mmopen/vi_32/Q0j4TwGTfTL77I4uYg4oBPAe0cwfY0EcRETRv1v7TWNOZB6iaohTBSNuZvrySoKoo2nTQnkzFOuBmeyfFbpUGrg/132","comment_is_top":false,"comment_ctime":1772118476,"is_pvip":false,"replies":[{"id":150610,"content":"抛开工具外壳，AI 编程的底层逻辑是 Context（上下文） 和 Prompt（指令）。\n       \n比如，使用 Cursor 时，将 CLAUDE.md 和 constitution.md 的内容写入它们的 .cursorrules 文件。\n                     \n虽然其他工具可能没有原生的 Skill 或 Hook 机制，但“规范驱动（SDD）”、“分层架构约束”的思想在任何支持大上下文的模型中都是通用的。","user_name":"作者回复","user_name_real":"编辑","uid":1026224,"ctime":1772364462,"ip_address":"美国","comment_id":405539,"utype":1}],"discussion_count":1,"race_medal":0,"score":4,"product_id":101089301,"comment_content":"如何将本课程的思想套用到其他AI编程工具？","like_count":0,"discussions":[{"author":{"id":1026224,"avatar":"https://static001.geekbang.org/account/avatar/00/0f/a8/b0/6f87ab08.jpg","nickname":"Tony Bai","note":"","ucode"