:147,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1773732936,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"北京","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":405745,"user_name":"石鑫元","can_delete":false,"product_type":"c3","uid":1325638,"ip_address":"广东","ucode":"AB3B68DB9C62B6","user_header":"https://static001.geekbang.org/account/avatar/00/14/3a/46/cd4f24ea.jpg","comment_is_top":false,"comment_ctime":1772717655,"is_pvip":false,"replies":[{"id":150693,"content":"这个说的很好，但是只限于顺序执行的process，如果后面学到分层和委派，就不会是这个感觉了","user_name":"作者回复","user_name_real":"编辑","uid":1521002,"ctime":1772793016,"ip_address":"北京","comment_id":405745,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":101114301,"comment_content":"人为的编排multi-agent，就是workflow工作，每个可以使用skill的agent不就是 工作流里的一个接地嘛。样例感觉可以照搬到最新的dify上，那multi-agent如何发挥它的优势，multi-agent之间自主互动和协同实现，能不能并行工作","like_count":2,"discussions":[{"author":{"id":1521002,"avatar":"https://static001.geekbang.org/account/avatar/00/17/35/6a/7997de5a.jpg","nickname":"晓寒","note":"","ucode":"8BB0F59591B8CC","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":681952,"discussion_content":"这个说的很好，但是只限于顺序执行的process，如果后面学到分层和委派，就不会是这个感觉了","content_length":124,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1772793016,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"北京","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":405818,"user_name":"Shopman","can_delete":false,"product_type":"c3","uid":1928457,"ip_address":"四川","ucode":"8411F9DEFC3D4D","user_header":"https://thirdwx.qlogo.cn/mmopen/vi_32/2giaUb5iczia7HciagrnDoo4hSSZKFQT0VXKyjE9eBb2FzBGvD2qoU0icS3WYRvN15BM6iaicW9cOTmewDHrDvFPIIcLQ/132","comment_is_top":false,"comment_ctime":1772983342,"is_pvip":false,"replies":[{"id":150753,"content":"1 每个agent仍然是这样的，可能出现上下文爆掉。但是分成multi-agent的好处是任务本身的拆解。之前都堆在一起，但是现在，大的调研任务会分为很多搜索子任务，每个子任务一旦执行完，只会返回结果，中间数据就不会影响别人了。\n2 在配置crew的时候，如果你有配置allow委派，crewai自己会在上下文把有哪些agent注进去，但是同时也建议在编写agent的时候，也明确告诉agent你有哪些伙伴，什么时候用。","user_name":"作者回复","user_name_real":"编辑","uid":1521002,"ctime":1773123205,"ip_address":"北京","comment_id":405818,"utype":1}],"discussion_count":2,"race_medal":0,"score":2,"product_id":101114301,"comment_content":"有点没太明白，\n1：单agent上下文会爆是因为每一次提交LLM是向message[].push(xxx) 给LLM这样工作，多agent这一课内容的agent不是这样工作的吗？如：网络搜索专家agent，多次被调用如果是 message[].push(xxx)  这样提交LLM一样存在爆上下文。\n2：这些agent是如何知道有哪些agent存在？这一点课程没怎么提，以文件方式通信实质上是agent之间的通信是很重要的内容这一点也没提，如果我要给多个agent传参怎么办？返回的结果又怎么拿到？","like_count":1,"discussions":[{"author":{"id":1521002,"avatar":"https://static001.geekbang.org/account/avatar/00/17/35/6a/7997de5a.jpg","nickname":"晓寒","note":"","ucode":"8BB0F59591B8CC","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":682139,"discussion_content":"1 每个agent仍然是这样的，可能出现上下文爆掉。但是分成multi-agent的好处是任务本身的拆解。之前都堆在一起，但是现在，大的调研任务会分为很多搜索子任务，每个子任务一旦执行完，只会返回结果，中间数据就不会影响别人了。\n2 在配置crew的时候，如果你有配置allow委派，crewai自己会在上下文把有哪些agent注进去，但是同时也建议在编写agent的时候，也明确告诉agent你有哪些伙伴，什么时候用。","content_length":528,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1773123206,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"北京","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":2888144,"avatar":"https://thirdwx.qlogo.cn/mmopen/vi_32/Cc3cesNQJNTnKXumfibW5RzyjPuHY85ibuhib5iadsodrdU