mber":0,"child_discussions":[]}]},{"had_liked":false,"id":406616,"user_name":"Geek_a49b28","can_delete":false,"product_type":"c1","uid":4338634,"ip_address":"湖南","ucode":"CCDC5014A9BA92","user_header":"","comment_is_top":false,"comment_ctime":1775463441,"is_pvip":false,"replies":[{"id":151159,"content":"我觉得最快的方法就是：你现在看不懂，你就把你不懂的去问claude code，然后同步学习、思考就可以了。 以这门课为主线，不懂就展开学，我理解课程结束后，你就了解架构是什么了\n","user_name":"作者回复","user_name_real":"编辑","uid":1299071,"ctime":1775545692,"ip_address":"广东","comment_id":406616,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":101128701,"comment_content":"小白对于架构不了解，需要补充些什么知识，有些术语看不懂","like_count":0,"discussions":[{"author":{"id":1299071,"avatar":"https://static001.geekbang.org/account/avatar/00/13/d2/7f/a761677e.jpg","nickname":"robert","note":"","ucode":"8D6AB35808A88C","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":683301,"discussion_content":"我觉得最快的方法就是：你现在看不懂，你就把你不懂的去问claude code，然后同步学习、思考就可以了。 以这门课为主线，不懂就展开学，我理解课程结束后，你就了解架构是什么了\n","content_length":241,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1775545692,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"广东","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2,\"source\":0}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":406483,"user_name":"星夜宝宝","can_delete":false,"product_type":"c1","uid":1334215,"ip_address":"黑龙江","ucode":"958CEA5A12850C","user_header":"https://static001.geekbang.org/account/avatar/00/14/5b/c7/5d8b2d4f.jpg","comment_is_top":false,"comment_ctime":1775055798,"is_pvip":false,"replies":null,"discussion_count":4,"race_medal":0,"score":3,"product_id":101128701,"comment_content":"老师，我要是用 TRAE，完了也按照你的这个 ，也可以。不一定非得是 Claude Code","like_count":2,"discussions":[{"author":{"id":1299071,"avatar":"https://static001.geekbang.org/account/avatar/00/13/d2/7f/a761677e.jpg","nickname":"robert","note":"","ucode":"8D6AB35808A88C","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":683031,"discussion_content":"是的，不一定用claude code。 因为做事情的思路是一致的。 怎么拆解问题，怎么执行。两者的区别在于可能trae写出来的代码质量没claude code好。可能claude code一遍就能写出好的代码，trae 要写多次。但是这未尝不是一个好事呢，因为trae 写出来的质量不是那么好（假设哈，没有disstrae的意思）的话，可以促使我们去思考，去琢磨细节，为什么不好，哪里有bug。我反而觉得可以学的更多。所以从合格角度，我个人看法，在学习阶段反而建议不要用那么强的工具。","content_length":606,"likes_number":3,"is_delete":false,"is_hidden":false,"ctime":1775093209,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"重庆","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1448188,"avatar":"https://static001.geekbang.org/account/avatar/00/16/18/fc/0510a8fc.jpg","nickname":"风起","note":"","ucode":"E4ECF5F96554D2","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":683027,"discussion_content":"trae 和 claude code 都是工具，工具的下游是大模型，就如小明喜欢在图书馆学习、小芳喜欢在咖啡店学习罢了。我们用哪个工具不重要，重要的是思路或者方法论，放诸四海而皆准。","content_length":237,"likes_number":2,"is_delete":false,"is_hidden":false,"ctime":1775090054,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"广东","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1817289,"avatar":"https://static001.geekbang.org/account/avatar/00/1b/ba/c9/626dcf2f.jpg","nickname":"skyi","note":"","ucode":"11197E4C0EDA34","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":683275,"discussion_content"