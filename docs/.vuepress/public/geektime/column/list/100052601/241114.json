:"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":502758,"discussion_content":"不是，是你把业务逻辑混在了增删改查里面。","content_length":20,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1596184568,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1120997,"avatar":"https://static001.geekbang.org/account/avatar/00/11/1a/e5/6899701e.jpg","nickname":"favorlm","note":"","ucode":"CFD52127AA6E1D","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":629814,"discussion_content":"朋友，请问你明白业务逻辑混在了增删改查里面，是什么意思了吗","content_length":29,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1697678433,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"澳大利亚","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":222904,"user_name":"Jxin","can_delete":false,"product_type":"c1","uid":1251111,"ip_address":"","ucode":"4C03928388C413","user_header":"https://static001.geekbang.org/account/avatar/00/13/17/27/ec30d30a.jpg","comment_is_top":false,"comment_ctime":1590948983,"is_pvip":false,"replies":[{"id":82250,"content":"这个课后思考题就是让大家有一个重新思考的过程。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1591056927,"ip_address":"","comment_id":222904,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100052601,"comment_content":"1.模型：圈定了数据，明确了边界。在我的数据范围内的业务才是我的业务。模型是业务的抽象定义。\n2.接口：定义了功能，明确了提供什么服务和这个服务的规格。接口是业务的功能口径。\n3.实现：选择技术，明确了功能的性能，满足接口的规格，实现业务的逻辑。实现与业务无关，只考虑接口规格和技术选型。\n\n\n以上个人理解。课后题有点广。没办法随手解答。得有时间翻个项目才好说。","like_count":7,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":496952,"discussion_content":"这个课后思考题就是让大家有一个重新思考的过程。","content_length":23,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1591056927,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":252121,"user_name":"刘岳","can_delete":false,"product_type":"c1","uid":1128385,"ip_address":"","ucode":"67C35B2518BF24","user_header":"https://static001.geekbang.org/account/avatar/00/11/37/c1/481ddf9b.jpg","comment_is_top":false,"comment_ctime":1602131784,"is_pvip":false,"replies":[{"id":92867,"content":"这个理解很到位。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1603153859,"ip_address":"","comment_id":252121,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100052601,"comment_content":"看完老师的文章做了下总结：模型可以理解为对要解决问题的抽象，这里可能更倾向于建模的意思，只有清晰的定义好要解决问题才能写出好的软件，这也是以终为始原则的一个体现吧。一个大的软件还会分解出很多小的模块，小的模块同样适用模型、接口、实现的原则，但小的模块又是上层抽象实现的一部分。接口是软件对外暴露的最基本方法，可以比作成软件的说明书。实现则更具体，接口的稳定性很高，我们可以根据具体情况更改内部实现","like_count":5,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":506721,"discussion_content":"这个理解很到位。","content_length":8,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1603153859,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":224452,"user_name":"chenzesam","can_delete":false,"product_type":"c1","uid":1045011,"ip_address":"","ucode":"34E76BB9C7618D","user_header":"https://static001.geekbang.org/account/avatar/00/0f/f2/13/3ee5a9b4.jpg","comment_is_top":false,"comment_ctime":1591405040,"is_pvip":false,"replies":[{"id":82671,"content":"好的设计都是类似的。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1591448915,"ip_address":"","comment_id":224452,"utype":1}],"discussion_count":1,"race_medal":0,"score":2,"product_id":100052601,"comment_content":"以前一直以为 react 的接口设计很有前瞻性，以至于它们的内部架构改了几次对于使用者来说都没什么影响。\n读了这个课程之后才发现，它们只是严格遵循了软件设计的原则罢了。\n以前一直苦于不知如何改进现有项目的腐败点以及文档的产出，在这里我找到了切入点了，谢谢老师🌹","like_count":4,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":497480,"discussion_content":"好的设计都是类似的。","content_length":10,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1591448915,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":223140,"user_name":"奕","can_delete":false,"product_type":"c1","uid":1005391,"ip_address":"","ucode":"73CEA468CE70C3","user_header":"https://static001.geekbang.org/account/avatar/00/0f/57/4f/6fb51ff1.jpg","comment_is_top":false,"comment_ctime":1591007986,"is_pvip":false,"replies":[{"id":87220,"content":"每个软件都有这几个东西。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1595320751,"ip_address":"","comment_id":223140,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":100052601,"comment_content":"当使用一个新的 库或者框架的时候 首先看的是 接口，看对外提供的功能的是否满足自己的要求，然后才是 具体的实现。 对于模型 想学习开源软件的架构的时候在去关注的","like_count":4,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":497026,"discussion_content":"每个软件都有这几个东西。","content_length":12,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1595320751,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":225325,"user_name":"Geek_q29f6t","can_delete":false,"product_type":"c1","uid":1299521,"ip_address":"","ucode":"1FDEC87C133E28","user_header":"https://static001.geekbang.org/account/avatar/0.png","comment_is_top":false,"comment_ctime":1591715009,"is_pvip":false,"replies":[{"id":83199,"content":"你可以把模型理解成一个个的类，但是，到了框架，就和实现相关了。MVC是一种设计模式，DDD是一种设计方法，TDD是一种实践。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1591878752,"ip_address":"","comment_id":225325,"utype":1}],"discussion_count":2,"race_medal":0,"score":3,"product_id":100052601,"comment_content":"老师好：\n模型是否可以这样理解：它可以包括，软件中有哪些类，类与类之间是如何组织的；软件中用了哪些框架（是MVC，还是DDD，TTD；也可以是业务模块之间的关系。总之，它是软件最基础，最核心的，也是最不可变的内容，最有别于其他软件的部分。\n","like_count":3,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":497807,"discussion_content":"你可以把模型理解成一个个的类，但是，到了框架，就和实现相关了。MVC是一种设计模式，DDD是一种设计方法，TDD是一种实践。","content_length":62,"likes_number":1,"is_delete":false,"is_hidden":false,"ctime":1591878752,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1515149,"avatar":"https://static001.geekbang.org/account/avatar/00/17/1e/8d/5b242931.jpg","nickname":"Fish","note":"","ucode":"C20719F8B0F7C8","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":349285,"discussion_content":"模型可以理解为DDD里的领域模型吗？","content_length":18,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1613038418,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":222981,"user_name":"FelixFly","can_delete":false,"product_type":"c1","uid":1160461,"ip_address":"","ucode":"1D39A7C3D0E31F","user_header":"https://static001.geekbang.org/account/avatar/00/11/b5/0d/0e65dee6.jpg","comment_is_top":false,"comment_ctime":1590976894,"is_pvip":false,"replies":[{"id":82253,"content":"有了地图，才不迷路。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1591057609,"ip_address":"","comment_id":222981,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":100052601,"comment_content":"这个分析思路比较好，好多一上来就深入源码细节（实现）容易懵，特别是集成关系比较重的时候，最后都不知道调用到哪地方去了，这样就需要单步跟踪才能了解其脉络。若是先分析了类的层次关系，有个一定的理解，后面的调用脉络就有一定的清晰认识。模型这部分比较难理解，要想到作者为什么会这样定义模型，这样的设计用途是什么，可能刚开始不了解，到实现部分有种豁然开朗的感觉。","like_count":3,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":496979,"discussion_content":"有了地图，才不迷路。","content_length":10,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1591057609,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":238093,"user_name":"宙斯","can_delete":false,"product_type":"c1","uid":2041396,"ip_address":"","ucode":"80DF36BAD298AD","user_header":"https://static001.geekbang.org/account/avatar/00/1f/26/34/891dd45b.jpg","comment_is_top":false,"comment_ctime":1596070318,"is_pvip":false,"replies":[{"id":88015,"content":"没文档就问人，先梳理一个出来。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1596105375,"ip_address":"","comment_id":238093,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":100052601,"comment_content":"对于模型这东西怎样才能真正地很好地了解到软件的模型呢？因为通常一款软件可能就一些代码，相关文档也没有提到更多的信息。","like_count":2,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":502642,"discussion_content":"没文档就问人，先梳理一个出来。","content_length":15,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1596105375,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":222978,"user_name":"escray","can_delete":false,"product_type":"c1","uid":1020525,"ip_address":"","ucode":"1F4204930E47C4","user_header":"https://static001.geekbang.org/account/avatar/00/0f/92/6d/becd841a.jpg","comment_is_top":false,"comment_ctime":1590976266,"is_pvip":false,"replies":[{"id":84912,"content":"模型只有名词是一个误区，模型里会包含动词的，比如，Service从角色上讲，就是一种动词。后面你还会看到相关的讨论。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1593262598,"ip_address":"","comment_id":222978,"utype":1}],"discussion_count":4,"race_medal":0,"score":3,"product_id":100052601,"comment_content":"看了文章，知道自己以前为什么读不懂源码了，因为我每次都是从“实现”入手，想要自顶向上的去了解整个软件的架构，也许这条路也能走通，但是难度太大。\n\n之前看过《代码阅读方法与实践》（和大多数书一样没能看完），这本书其实就是从细节开始讲起的，书是好书，但是我的打开方式似乎有点问题。\n\n进程管理的模型包括调度算法，这个稍微有一点不好理解，我之前以为模型都是一些比较“实”的东西。不过如果从模型是“名词” &#47; 概念，接口是“动词” &#47; 命令，实现是动作 &#47; 技术细节这个角度就更清楚一些。\n\n翻回到专栏的第一篇，老师举例说在交易系统中，有交易原语：下单、成交和撤单，交易动作：冻结、解冻、出金、入金，当时解释说这是模型上的分层。那么我的问题是，这些原语和动作都当做模型来看待么？\n\n如果让我来分析，那么交易系统的模型可能是：用户、商品、订单、支付、物流；接口是：下单、成交、撤单……\n\n看到 @Kǎfκã²⁰²⁰ 的留言，他是把“回款”也放到模型里面了。\n\n似乎是因为老师抽象的层次更高一点，期待下一篇关于模型的讲解。","like_count":2,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":496978,"discussion_content":"模型只有名词是一个误区，模型里会包含动词的，比如，Service从角色上讲，就是一种动词。后面你还会看到相关的讨论。","content_length":58,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1593262598,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1587392,"avatar":"https://static001.geekbang.org/account/avatar/00/18/38/c0/04decf07.jpg","nickname":"大京","note":"","ucode":"CB4C529635D434","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":278426,"discussion_content":"用户，商品，商品订单：创建（入参商品）；支付订单：创建（入参商品订单），支付；物流订单：创建（商品订单，商品），追加物流信息，完成","content_length":65,"likes_number":1,"is_delete":false,"is_hidden":false,"ctime":1591185566,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1515149,"avatar":"https://static001.geekbang.org/account/avatar/00/17/1e/8d/5b242931.jpg","nickname":"Fish","note":"","ucode":"C20719F8B0F7C8","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":349290,"discussion_content":"理解软件是不是也要从开发软件角度来类比考虑？\n先了解需求，然后看实体，再看接口。","content_length":40,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1613039801,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]},{"author":{"id":1515149,"avatar":"https://static001.geekbang.org/account/avatar/00/17/1e/8d/5b242931.jpg","nickname":"Fish","note":"","ucode":"C20719F8B0F7C8","race_medal":0,"user_type":1,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":349289,"discussion_content":"模型=实体+处理？","content_length":9,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1613039697,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":false,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":223035,"user_name":"业余爱好者","can_delete":false,"product_type":"c1","uid":1482915,"ip_address":"","ucode":"A890935A982988","user_header":"https://static001.geekbang.org/account/avatar/00/16/a0/a3/8da99bb0.jpg","comment_is_top":false,"comment_ctime":1590984876,"is_pvip":false,"replies":[{"id":85082,"content":"很好的补充，但 ADT 的说法，容易让人误解成实现。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1593408878,"ip_address":"","comment_id":223035,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":100052601,"comment_content":"使用一个软件，就是通过其接口进行的。接口分为api和ui。要想正确使用一个东西，就要知道一点内部的原理。模型是对内部原理的简化，可以让人快速上手。如果想玩一些高级的玩法，或者想要改造软件，就少不了研究实现了。\n\n接口和模型组合起来，就相当于一个“ADT”。","like_count":1,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":496994,"discussion_content":"很好的补充，但 ADT 的说法，容易让人误解成实现。","content_length":26,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1593408878,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":222926,"user_name":"阳仔","can_delete":false,"product_type":"c1","uid":1046920,"ip_address":"","ucode":"79F73D85EDF3E2","user_header":"https://static001.geekbang.org/account/avatar/00/0f/f9/88/cdda9e6f.jpg","comment_is_top":false,"comment_ctime":1590968266,"is_pvip":false,"replies":[{"id":82251,"content":"希望这个结构对你理解软件设计有帮助。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1591057520,"ip_address":"","comment_id":222926,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":100052601,"comment_content":"理解软件开发中的设计可以通过三步走套路:\n模型-接口-实现，\n这个也就是了解软件设计的“模型”。\n模型其实是一个软件设计中的抽象，通过与其它软件设计中的进行对比学习，理解它们的异同，突出自身的核心抽象结构;\n接口是软件交互的入口，是一个软件系统的能力提现，它是一种规范，它与模型共同组成了软件系统的稳定性因素;\n实现是软件设计中对模型和接口的具体的逻辑实现，这个很好理解\n\n有了这个套路，学习软件设计就有了章法，不会盲目的陷入到软件开发的代码中","like_count":1,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":496962,"discussion_content":"希望这个结构对你理解软件设计有帮助。","content_length":18,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1591057520,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":318220,"user_name":"hey_boy0532","can_delete":false,"product_type":"c1","uid":1048127,"ip_address":"","ucode":"E2F71C25122824","user_header":"https://static001.geekbang.org/account/avatar/00/0f/fe/3f/2109c13f.jpg","comment_is_top":false,"comment_ctime":1635210220,"is_pvip":false,"replies":[{"id":115454,"content":"看你怎么理解架构了，如果你把架构理解成什么样的代码应该放在什么地方，他更多的是一种规范，而不是模型。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1635258484,"ip_address":"","comment_id":318220,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":100052601,"comment_content":"这里的模型，是否等同于代码的架构？","like_count":0,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":529142,"discussion_content":"看你怎么理解架构了，如果你把架构理解成什么样的代码应该放在什么地方，他更多的是一种规范，而不是模型。","content_length":50,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1635258484,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":265622,"user_name":"苏忆","can_delete":false,"product_type":"c1","uid":1042793,"ip_address":"","ucode":"B8BE78280CCB99","user_header":"https://static001.geekbang.org/account/avatar/00/0f/e9/69/779b48c2.jpg","comment_is_top":false,"comment_ctime":1606963348,"is_pvip":false,"replies":[{"id":96619,"content":"只看细节的话，看不到全貌。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1607067575,"ip_address":"","comment_id":265622,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":100052601,"comment_content":"老师今天提供的思路特别好,终于知道为啥不能很好的掌握一个系统的精髓了,老是感觉自己没有整体的把握.就是因为思路不对","like_count":0,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":511000,"discussion_content":"只看细节的话，看不到全貌。","content_length":13,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1607067575,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":223892,"user_name":"☆淡蓝水岸☆","can_delete":false,"product_type":"c1","uid":1443262,"ip_address":"","ucode":"A13D351C806CDE","user_header":"https://static001.geekbang.org/account/avatar/00/16/05/be/eb1588b0.jpg","comment_is_top":false,"comment_ctime":1591226929,"is_pvip":false,"replies":[{"id":84633,"content":"后面你会看到不同的模块组织方式，本质上，C++的组织方式只有一个“类”的概念，幸好有宏定义，可以定义出不同的概念。","user_name":"作者回复","user_name_real":"郑晔","uid":1258861,"ctime":1592968769,"ip_address":"","comment_id":223892,"utype":1}],"discussion_count":1,"race_medal":0,"score":3,"product_id":100052601,"comment_content":"例如在C++的一个小系统中，模型可以理解为定义的类么？接口类似于类里面的函数，接口类似于函数的调用？","like_count":0,"discussions":[{"author":{"id":1258861,"avatar":"https://static001.geekbang.org/account/avatar/00/13/35/6d/07a42f81.jpg","nickname":"郑晔","note":"","ucode":"1EBD5AA5D4FC89","race_medal":0,"user_type":2,"is_pvip":false},"reply_author":{"id":0,"avatar":"","nickname":"","note":"","ucode":"","race_medal":0,"user_type":1,"is_pvip":false},"discussion":{"id":497287,"discussion_content":"后面你会看到不同的模块组织方式，本质上，C++的组织方式只有一个“类”的概念，幸好有宏定义，可以定义出不同的概念。","content_length":57,"likes_number":0,"is_delete":false,"is_hidden":false,"ctime":1592968769,"is_liked":false,"can_delete":false,"is_complain":false,"is_top":true,"parent_id":0,"ip_address":"","group_id":0,"attachments":[]},"score":2,"extra":"{\"reply\":true,\"user_type\":2}","child_discussion_number":0,"child_discussions":[]}]},{"had_liked":false,"id":241555,"user_name":"w0807m","can_delete":false,"product_type":"c1","uid":1003931,"ip_address":"","ucode":"A23769F77ED2C1","user_header":"https://static001.geekbang.org/account/avatar/00/0f/51/9b/540c0aef.jpg","comment_is_top":false,"comment_ctime":1597334457,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100052601,"comment_content":"模型 接口 实现 三步走，跟我们画一幅人像，先画大的棱廓，这就相当于模型，然后画骨骼，这就像接口，最好在填充，就到了实现。","like_count":2},{"had_liked":false,"id":382025,"user_name":"术子米德","can_delete":false,"product_type":"c1","uid":1898023,"ip_address":"浙江","ucode":"382EA7E2AF0B56","user_header":"https://static001.geekbang.org/account/avatar/00/1c/f6/27/c27599ae.jpg","comment_is_top":false,"comment_ctime":1696555123,"is_pvip":true,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100052601,"comment_content":"🤔☕️🤔☕️🤔\n【R】维护项目，查看代码，迷失其中。\n【.I.】打开源代码看一眼，这具有难以拒绝的吸引力；东点西看一番，看得懂的地方，即使没有源代码，都能猜测到，看不明白的地方，最期盼能启动调试，并且在代码当前行停下来，在实际的上下文里，秒懂代码的意图。也就是说，看懂代码，一方面在代码未见之前就懂，另一方面在代码跑后才懂，很难有放在眼前看懂的情况。\n【R】看软件设计 = 模型&lt;抽象&gt; + 接口 + 实现。\n讨论设计顺序：左 → 中 → 右\n【.I.】模型=剪刀+胶水，玩模型不都是先剪开，就像把待解决的问题拆解，然后再用胶水粘起来，就是在解决方案之下进行重组，粘出问题的答案。接口就是胶水能够图上去，进行粘帖的地方。模型和接口拼出来最终的样子，实现则隐藏其中。这样就能解释，一开始就打开实现，迷失就会是大概率事件。\n模型说到底，也算种领域语言，语法和语义由模型定义，语料由接口来补位。拿着模型讨论，解耦掉实现，只关注在问题和方案之间，讲清楚问题将如何解决，以及解决到何种程度。\n【Q】拿到源码，通过查看代码，反推模型和接口，这样是否可行？\n    ---- by 术子米德@2023年10月6日","like_count":1},{"had_liked":false,"id":343008,"user_name":"熊猫宝宝","can_delete":false,"product_type":"c1","uid":1663921,"ip_address":"","ucode":"F082F925933C4E","user_header":"https://static001.geekbang.org/account/avatar/00/19/63/b1/6b9b9d8e.jpg","comment_is_top":false,"comment_ctime":1650591425,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100052601,"comment_content":"说实话，文章有点偏离主题了，我看标题应该是讲软件如何设计，你这拿着代码讲过来讲过去确实不好理解，比如你应该这样，订单模块，我们怎么分析，弄个例子","like_count":1},{"had_liked":false,"id":316130,"user_name":"王峰","can_delete":false,"product_type":"c1","uid":1216387,"ip_address":"","ucode":"11C31B45C31B0B","user_header":"https://static001.geekbang.org/account/avatar/00/12/8f/83/3f99d078.jpg","comment_is_top":false,"comment_ctime":1634173867,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100052601,"comment_content":"模型也称作抽象，是否可以理解为为了解决现实问题，将客户需求转化后的软件设计方案的呈现，既通过提供怎样的软件架构和模块来满足需求？","like_count":1},{"had_liked":false,"id":223228,"user_name":"三生","can_delete":false,"product_type":"c1","uid":1606669,"ip_address":"","ucode":"1DE1A2693A5E33","user_header":"https://static001.geekbang.org/account/avatar/00/18/84/0d/4e289b94.jpg","comment_is_top":false,"comment_ctime":1591024207,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100052601,"comment_content":"分析框架的流程应当从子模型往上建模，\n若从mvc入手，开始分析其内部的子模型是怎么实现，感觉虽然明显看到顶层模型的交互但是会很含糊。\n认为应当自底向上的进行分析，从框架运行的流程（生命周期）进行模型分析再上升为组件模型，最后总结mvc模型&#47;其他模型，这种分析的方式，虽然相反，但是感觉更容易懂\n","like_count":1},{"had_liked":false,"id":402993,"user_name":"雪飞鸿","can_delete":false,"product_type":"c1","uid":1012325,"ip_address":"上海","ucode":"65D7B030828809","user_header":"https://static001.geekbang.org/account/avatar/00/0f/72/65/c3fc7642.jpg","comment_is_top":false,"comment_ctime":1760836299,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100052601,"comment_content":"先了解概念，再了解细节","like_count":0},{"had_liked":false,"id":400650,"user_name":"慎独明强","can_delete":false,"product_type":"c1","uid":1965699,"ip_address":"湖南","ucode":"DC2F7F2C0C8F60","user_header":"https://static001.geekbang.org/account/avatar/00/1d/fe/83/df562574.jpg","comment_is_top":false,"comment_ctime":1748732293,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100052601,"comment_content":"结合自己所在的业务域的一次架构升级谈谈什么是设计。\n1. 模型：订补货规则、商品、库存、销量（预测销量、历史销量）、安全库存、运营配置等模型。\n2.接口：建议量计算。\n3.实现：分布式计算，更具体的实现是通过spark sql、spark-api。是java或python","like_count":0},{"had_liked":false,"id":379881,"user_name":"6点无痛早起学习的和尚","can_delete":false,"product_type":"c1","uid":1703256,"ip_address":"北京","ucode":"33A8A1CDA103F9","user_header":"https://static001.geekbang.org/account/avatar/00/19/fd/58/1af629c7.jpg","comment_is_top":false,"comment_ctime":1692663535,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":2,"score":4,"product_id":100052601,"comment_content":"看了评论，真的太精彩，是对课程内容很好的补充和理解，学到了！","like_count":0},{"had_liked":false,"id":376892,"user_name":"奕涛_steve","can_delete":false,"product_type":"c1","uid":1630504,"ip_address":"广东","ucode":"07B39F3C746C3C","user_header":"https://static001.geekbang.org/account/avatar/00/18/e1/28/0a26566d.jpg","comment_is_top":false,"comment_ctime":1687671091,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100052601,"comment_content":"一个系统的模型就是系统包含的模块与模块间的关系。模型设计就是根据需求拆分高内聚、低耦合的模块，并描述清楚各模块的职责与关系。\n除了设计模型，我们还需要制定规范，从而确保后续迭代跟着设计的方向走。\n此外，模型设计不应该是一次性行为。我们还应该随着新需求不断审视已有设计，在必要时对其扩展甚至重构。那么，设计模型时怎么为后续的扩展或重构留空间呢？等我学完后再总结。","like_count":0},{"had_liked":false,"id":372225,"user_name":"你好，Java","can_delete":false,"product_type":"c1","uid":2281842,"ip_address":"中国台湾","ucode":"4FA103B707B78D","user_header":"","comment_is_top":false,"comment_ctime":1680858467,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":4,"product_id":100052601,"comment_content":"你hashmap那個舉例不好\n你應該就以前員工、計算薪資為例\n切分好模組（你說的模型）\n然後訂好接口 \n員工 getName\n財務 createSalary\n\n實現就是把getName, createSalary的logic寫出來","like_count":0},{"had_liked":false,"id":368412,"user_name":"zachaxy","can_delete":false,"product_type":"c1","uid":1139887,"ip_address":"北京","ucode":"FD7B5C7535361B","user_header":"https://static001.geekbang.org/account/avatar/00/11/64/af/7560c8d8.jpg","comment_is_top":false,"comment_ctime":1676300991,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100052601,"comment_content":"看设计先看模型，这里面的模型可以理解为是软件的组件图所呈现的状态码？","like_count":0},{"had_liked":false,"id":347678,"user_name":"Bumblebee","can_delete":false,"product_type":"c1","uid":2051293,"ip_address":"","ucode":"B879C8A511D08D","user_header":"https://static001.geekbang.org/account/avatar/00/1f/4c/dd/c6035349.jpg","comment_is_top":false,"comment_ctime":1654306896,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100052601,"comment_content":"阅读开源软件的源码（开源软件往往涉及多个模块）应该是这么一个思路\n\n① 了解整体模型；\n\n② 了解局部模型；\n\n③ 了解局部接口；\n\n④ 了解接口实现；","like_count":0},{"had_liked":false,"id":347677,"user_name":"Bumblebee","can_delete":false,"product_type":"c1","uid":2051293,"ip_address":"","ucode":"B879C8A511D08D","user_header":"https://static001.geekbang.org/account/avatar/00/1f/4c/dd/c6035349.jpg","comment_is_top":false,"comment_ctime":1654306648,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100052601,"comment_content":"模型，接口，实现；","like_count":0},{"had_liked":false,"id":345053,"user_name":"ifelse","can_delete":false,"product_type":"c1","uid":2550743,"ip_address":"","ucode":"D0565908C99695","user_header":"https://static001.geekbang.org/account/avatar/00/26/eb/d7/90391376.jpg","comment_is_top":false,"comment_ctime":1651986790,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":3,"score":5,"product_id":100052601,"comment_content":"了解设计，先模型，再接口，最后是实现--记下来","like_count":0},{"had_liked":false,"id":342340,"user_name":"William Ning","can_delete":false,"product_type":"c1","uid":1592279,"ip_address":"","ucode":"4DB8D05E69E5F3","user_header":"https://static001.geekbang.org/account/avatar/00/18/4b/d7/f46c6dfd.jpg","comment_is_top":false,"comment_ctime":1650201539,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100052601,"comment_content":"打卡，有收获～","like_count":0},{"had_liked":false,"id":335352,"user_name":"Geek_7410f1","can_delete":false,"product_type":"c1","uid":2212662,"ip_address":"","ucode":"1BD092AFDDEE3C","user_header":"","comment_is_top":false,"comment_ctime":1645464424,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100052601,"comment_content":"我想知道，对于一份之前完全没看过的源代码，我怎么能先了解到它的模型是什么样的呢，看文档嘛","like_count":0},{"had_liked":false,"id":283420,"user_name":"许凯","can_delete":false,"product_type":"c1","uid":1604645,"ip_address":"","ucode":"4F11AD41CB0244","user_header":"https://static001.geekbang.org/account/avatar/00/18/7c/25/70134099.jpg","comment_is_top":false,"comment_ctime":1615776884,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100052601,"comment_content":"系统由功能和配置组成，配置就是模型，配置由要素和连接关系组成，要素和连接关系可以由抽象和实现组成","like_count":0},{"had_liked":false,"id":265627,"user_name":"苏忆","can_delete":false,"product_type":"c1","uid":1042793,"ip_address":"","ucode":"B8BE78280CCB99","user_header":"https://static001.geekbang.org/account/avatar/00/0f/e9/69/779b48c2.jpg","comment_is_top":false,"comment_ctime":1606964424,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100052601,"comment_content":"背景(实际问题)---&gt;功能点(解决方案)---&gt;模型---&gt;接口---&gt;实现","like_count":0},{"had_liked":false,"id":237243,"user_name":"匠心","can_delete":false,"product_type":"c1","uid":1898691,"ip_address":"","ucode":"1778B6EA6BC82A","user_header":"https://static001.geekbang.org/account/avatar/00/1c/f8/c3/64e3c953.jpg","comment_is_top":false,"comment_ctime":1595754376,"is_pvip":false,"replies":null,"discussion_count":0,"race_medal":0,"score":5,"product_id":100052601,"comment_content":"我的理解是：模型好比数学公式，类组成了公式中的变量；接口指明该公式能够解决哪些问题；实现就是在公式和接口的约束下写出简洁的、高效的、正确无误的解题步骤。","like_count":0}]}